@model XFLCSMS.Models.Todos.TodoReportView;
@{
    Layout = "_Layout";
}

<!-- Main content -->
<section class="content">
    <div class="card">
        <div class="card-header">
            <h5 class="text-center"><b>Generate Your To-Do Report</b></h5>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-10 offset-md-1">
                        <form id="advancedSearchForm" asp-action="AllTodoSearch" method="get">
                            <div class="row justify-content-center">
                                <div class="col-4">
                                    <div class="form-group">
                                        <label for="assigningStatus">Status</label>
                                        <select asp-for="search.Status" class="form-control" id="assigningStatus">
                                            <option value="">--Select--</option>
                                            <option value="">All</option>
                                            <option value="In progress">In progress</option>
                                            <option value="Done">Closed</option>
                                            <option value="Completed">Canceled</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label for="bHouse">Brokerage House</label>
                                        <select asp-for="search.BrocarageHouseName" id="brokerageCodes" name="search.BrocarageHouseName" class="form-control">
                                            <option value="">--Select--</option>
                                            @foreach (var item in @Model.brokerages)
                                            {
                                                <option value="@item.BrokerageId">@item.BrokerageHouseName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label for="supportEngineer">Customers</label>
                                        <select asp-for="search.EmployeeName" id="supportEngineer" name="search.EmployeeName" class="form-control">
                                            <option value="">--Select--</option>
                                            @foreach (var item in @Model.ListofEmployee)
                                            {
                                                <option value="@item.Id">@item.FullName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row justify-content-center">
                                <div class="col-4">
                                    <div class="form-group">
                                        <label for="search_FromDate">From Date</label>
                                        <input asp-for="search.FromDate" type="date" class="form-control" id="search_FromDate" />
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label for="search_ToDate">To Date</label>
                                        <input asp-for="search.ToDate" type="date" class="form-control" id="search_ToDate" />
                                    </div>
                                </div>
                            </div>

                            <div class="row d-flex justify-content-center align-content-center">
                                <button type="button" class="btn btn-outline-primary" id="searchButton">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>

                        </form>

                    </div>
                    <div>
                        <h4> <b>Search Results:</b></h4>
                        <div id="searchResultsPlaceholder"></div>
                    </div>
                </div>


                <div class="card-tools text-right">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-card-widget="remove" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div id="searchResults">
                @if (Model.Todos != null)
                {
                    <partial name="_todoSearchResult" model="Model" />
                }
                else
                {
                    <p class="ml-3">No data found.</p>
                }
            </div>

            <div class="row d-flex justify-content-center align-content-center">
                <button type="button" class="btn btn-outline-secondary ml-2 mb-3" onclick="printResults()">
                    <i class="fas fa-print"></i> Print Results
                </button>
            </div>
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        $('#searchButton').click(function () {
            $.ajax({
                url: '/Admin/AllTodoSearch',
                type: 'GET',
                data: $('#advancedSearchForm').serialize(),
                success: function (response) {
                    $('#searchResults').html(response);
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                }
            });
        });
    });
</script>

<script>
    function printResults() {
        // Print only the result block. The old version replaced the whole <body> and put the HTML back
        // afterwards, which destroyed every event handler - the Search button was dead after printing.
        if (!document.getElementById("printResultsStyle")) {
            var style = document.createElement("style");
            style.id = "printResultsStyle";
            style.textContent = "@@media print {" +
                " body.print-results-only * { visibility: hidden !important; }" +
                " body.print-results-only #searchResults, body.print-results-only #searchResults * { visibility: visible !important; }" +
                " body.print-results-only #searchResults { position: absolute; left: 0; top: 0; width: 100%; } }";
            document.head.appendChild(style);
        }

        document.body.classList.add("print-results-only");
        window.print();
        document.body.classList.remove("print-results-only");
    }
</script>
