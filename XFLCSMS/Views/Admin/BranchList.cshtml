@model IEnumerable<XFLCSMS.Models.Branch.BranchView>
@{
    ViewData["Title"] = "Branches";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Branches</h1>
        <p class="page-sub">The offices of each brokerage house. Users pick their branch when they register.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateBranch"><icon name="plus" /> New branch</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No branches yet</b>
            <div><a class="btn btn-primary" asp-action="CreateBranch"><icon name="plus" /> New branch</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter branches" aria-label="Filter branches" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Branch</th>
                    <th scope="col">Brokerage house</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.BranchId">
                            <td class="t-id">@item.BranchId</td>
                        <td class="c-title"><span class="t-title">@item.BranchName</span></td>
                        <td>@item.BrokerageHouseName</td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewBranch" asp-route-id="@item.BranchId" title="View" aria-label="View @item.BranchName"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditBranch" asp-route-id="@item.BranchId" title="Edit" aria-label="Edit @item.BranchName"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.BranchName"
                                        data-delete data-url="@Url.Action("DeleteBranch", new { id = item.BranchId })"
                                        data-confirm="Delete @item.BranchName?" data-confirm-text="A branch with registered users cannot be deleted." data-issue-id="@item.BranchId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="4" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
