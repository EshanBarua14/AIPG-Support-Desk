@model IEnumerable<XFLCSMS.Models.Brocarage.Brokerage>
@{
    ViewData["Title"] = "Brokerage houses";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Brokerage houses</h1>
        <p class="page-sub">The customers of XFL. Each user and ticket belongs to one house.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateBrocarage"><icon name="plus" /> New brokerage house</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No brokerage houses yet</b>
            <div><a class="btn btn-primary" asp-action="CreateBrocarage"><icon name="plus" /> New brokerage house</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter brokerage houses" aria-label="Filter brokerage houses" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Acronym</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.BrokerageId">
                            <td class="t-id">@item.BrokerageId</td>
                        <td class="c-title"><span class="t-title">@item.BrokerageHouseName</span></td>
                        <td>@item.BrokerageHouseAcronym</td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewBrocarageHouse" asp-route-id="@item.BrokerageId" title="View" aria-label="View @item.BrokerageHouseName"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditBrocarage" asp-route-id="@item.BrokerageId" title="Edit" aria-label="Edit @item.BrokerageHouseName"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.BrokerageHouseName"
                                        data-delete data-url="@Url.Action("DeleteBrocarage", new { id = item.BrokerageId })"
                                        data-confirm="Delete @item.BrokerageHouseName?" data-confirm-text="A house with branches, users or tickets cannot be deleted." data-issue-id="@item.BrokerageId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="4" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
