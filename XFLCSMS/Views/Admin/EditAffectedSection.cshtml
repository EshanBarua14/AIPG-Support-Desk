@model XFLCSMS.Models.Affected.AffectedSection
@{
    ViewData["Title"] = "Edit affected section";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="AffectedSectionList"><icon name="arrow-left" /> Affected sections</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit affected section</h1>
    </div>
</header>

<form class="card" asp-action="UpdateAffectedSection" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="AffectedSectionId">
        <div class="field">
            <label asp-for="ASection">Name</label>
            <input class="input" asp-for="ASection" placeholder="For example: Settlement" autocomplete="off" required>
            <span asp-validation-for="ASection"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="AffectedSectionList">Cancel</a>
    </div>
</form>
