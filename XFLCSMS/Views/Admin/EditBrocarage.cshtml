@model XFLCSMS.Models.Brocarage.Brokerage
@{
    ViewData["Title"] = "Edit brokerage house";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="BrocarageHouseList"><icon name="arrow-left" /> Brokerage houses</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit brokerage house</h1>
    </div>
</header>

<form class="card" asp-action="UpdateBrocarage" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="BrokerageId">
        <div class="field">
            <label asp-for="BrokerageHouseName">Name</label>
            <input class="input" asp-for="BrokerageHouseName" placeholder="For example: Green Delta Securities Ltd." autocomplete="off" required>
            <span class="hint">Letters, spaces and dots.</span>
            <span asp-validation-for="BrokerageHouseName"></span>
        </div>
        <div class="field">
            <label asp-for="BrokerageHouseAcronym">Acronym</label>
            <input class="input" asp-for="BrokerageHouseAcronym" placeholder="For example: GDSL" autocomplete="off" required>
            <span class="hint">Letters, no spaces. Ticket numbers start with it, like GDSL_0000001.</span>
            <span asp-validation-for="BrokerageHouseAcronym"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="BrocarageHouseList">Cancel</a>
    </div>
</form>
