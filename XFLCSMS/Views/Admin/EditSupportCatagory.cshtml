@model XFLCSMS.Models.Support.SupportCatagory
@{
    ViewData["Title"] = "Edit support category";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportCatagoryList"><icon name="arrow-left" /> Support categories</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit support category</h1>
    </div>
</header>

<form class="card" asp-action="UpdateSupportCatagory" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="SupportCatagoryId">
        <div class="field">
            <label asp-for="SCatagory">Name</label>
            <input class="input" asp-for="SCatagory" placeholder="For example: Software" autocomplete="off" required>
            <span class="hint">4 to 100 letters, no spaces.</span>
            <span asp-validation-for="SCatagory"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="SupportCatagoryList">Cancel</a>
    </div>
</form>
