@model XFLCSMS.Models.Support.SupportSubCatagory
@{
    ViewData["Title"] = "Edit support sub-category";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportSubCatagoryList"><icon name="arrow-left" /> Support sub-categories</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit support sub-category</h1>
    </div>
</header>

<form class="card" asp-action="UpdateSupportSubCatagory" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="SupportSubCatagoryId">
        <div class="field">
            <label asp-for="SubCatagory">Name</label>
            <input class="input" asp-for="SubCatagory" placeholder="For example: Login" autocomplete="off" required>
            <span class="hint">4 to 100 letters, no spaces.</span>
            <span asp-validation-for="SubCatagory"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="SupportSubCatagoryList">Cancel</a>
    </div>
</form>
