@model XFLCSMS.Models.Support.SupportType
@{
    ViewData["Title"] = "Edit support type";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportTypeList"><icon name="arrow-left" /> Support types</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit support type</h1>
    </div>
</header>

<form class="card" asp-action="UpdateSupportType" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="SupportTypeId">
        <div class="field">
            <label asp-for="SType">Name</label>
            <input class="input" asp-for="SType" placeholder="For example: Technical" autocomplete="off" required>
            <span class="hint">4 to 100 letters, no spaces.</span>
            <span asp-validation-for="SType"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="SupportTypeList">Cancel</a>
    </div>
</form>
