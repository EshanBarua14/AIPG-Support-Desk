@*
    Change what a user may do. Three settings decide the role at sign-in (see RegisterLoginController.Login):
    administrator -> Administrator; XFL staff + position -> Support Manager / Support Engineer; everything else -> Maker.
*@
@model XFLCSMS.Models.Admin.UserView
@{
    ViewData["Title"] = "Edit " + Model.FullName;
    ViewData["PageClass"] = "narrow";
    var positions = new[] { ("Maker", "Maker"), ("Support Engineer", "Support Engineer"), ("Support Maneger", "Support Manager") };
}
<a class="back" asp-action="UserList"><icon name="arrow-left" /> Users</a>

<header class="page-head">
    <div class="row" style="gap: 16px; flex-wrap: nowrap">
        <span class="avatar lg" aria-hidden="true">@Ui.Initials(Model.FullName)</span>
        <div>
            <h1 class="page-title">@Model.FullName</h1>
            <p class="page-sub">@Model.UserName, @Model.Email</p>
        </div>
    </div>
</header>

<form class="card" asp-action="UpdateUser" method="post" id="userForm">
    <input type="hidden" asp-for="Id">
    <div class="card-head">
        <h2>Role and access</h2>
        <span class="sub right">Signs in as <b id="rolePreview">@Ui.RoleOf(Model.UCatagory, Model.UType, Model.Department)</b></span>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div class="field">
                <label for="UType">Team</label>
                <select class="select" name="UType" id="UType">
                    <option value="False" selected="@(!Model.UType)">Brokerage house user</option>
                    <option value="True" selected="@Model.UType">XFL staff</option>
                </select>
                <span class="hint">Only XFL staff can be support engineers or managers.</span>
            </div>
            <div class="field">
                <label for="Department">Position</label>
                <select class="select" name="Department" id="Department">
                    @if (!string.IsNullOrEmpty(Model.Department) && !positions.Any(position => position.Item1 == Model.Department))
                    {
                        <option value="@Model.Department" selected>@Model.Department</option>
                    }
                    @foreach (var position in positions)
                    {
                        <option value="@position.Item1" selected="@(position.Item1 == Model.Department)">@position.Item2</option>
                    }
                </select>
                <span class="hint">Tickets can be assigned to support engineers.</span>
            </div>
            <div class="field">
                <label for="UCatagory">Administrator</label>
                <select class="select" name="UCatagory" id="UCatagory">
                    <option value="False" selected="@(!Model.UCatagory)">No</option>
                    <option value="True" selected="@Model.UCatagory">Yes</option>
                </select>
                <span class="hint">Administrators manage users and master data and can delete tickets.</span>
            </div>
            <div class="field">
                <label for="UStatus">Account</label>
                <select class="select" name="UStatus" id="UStatus">
                    <option value="True" selected="@Model.UStatus">Active</option>
                    <option value="False" selected="@(!Model.UStatus)">Disabled</option>
                </select>
                <span class="hint">A disabled user cannot sign in. Tickets and to-dos are kept.</span>
            </div>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="UserList">Cancel</a>
    </div>
</form>

<section class="card" style="margin-top: 18px">
    <div class="card-head"><h2>Registered details</h2><span class="sub">Entered by the user at registration</span></div>
    <div class="card-body">
        <dl class="facts">
            <dt>Employee ID</dt>
            <dd>@Model.EmployeeId</dd>
            <dt>Brokerage house</dt>
            <dd>@Model.BrokerageHouseName</dd>
            <dt>Branch</dt>
            <dd>@Model.Branch</dd>
            <dt>Phone</dt>
            <dd>@Model.PhonNumber</dd>
        </dl>
    </div>
</section>

@section Scripts {
    <script>
        // shows the role the choices add up to, before saving
        (function () {
            var form = document.getElementById('userForm');
            var preview = document.getElementById('rolePreview');
            function update() {
                var admin = form.UCatagory.value === 'True';
                var staff = form.UType.value === 'True';
                var position = form.Department.value;
                preview.textContent = admin ? 'Administrator'
                    : staff && position === 'Support Maneger' ? 'Support Manager'
                    : staff && position === 'Support Engineer' ? 'Support Engineer'
                    : 'Maker';
            }
            form.addEventListener('change', update);
        })();
    </script>
}
