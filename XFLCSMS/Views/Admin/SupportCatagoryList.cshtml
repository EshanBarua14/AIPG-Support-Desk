@model IEnumerable<XFLCSMS.Models.Support.SupportCatagory>
@{
    ViewData["Title"] = "Support categories";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Support categories</h1>
        <p class="page-sub">The second choice on the ticket form.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateSupportCatagory"><icon name="plus" /> New support category</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No support categories yet</b>
            <div><a class="btn btn-primary" asp-action="CreateSupportCatagory"><icon name="plus" /> New support category</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter support categories" aria-label="Filter support categories" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Name</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.SupportCatagoryId">
                            <td class="t-id">@item.SupportCatagoryId</td>
                        <td class="c-title"><span class="t-title">@item.SCatagory</span></td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewSupportCatagory" asp-route-id="@item.SupportCatagoryId" title="View" aria-label="View @item.SCatagory"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditSupportCatagory" asp-route-id="@item.SupportCatagoryId" title="Edit" aria-label="Edit @item.SCatagory"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.SCatagory"
                                        data-delete data-url="@Url.Action("DeleteSupportCatagory", new { id = item.SupportCatagoryId })"
                                        data-confirm="Delete @item.SCatagory?" data-confirm-text="A category that tickets use cannot be deleted." data-issue-id="@item.SupportCatagoryId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="3" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
