@* Every registered user. The role shown is the one the user gets when signing in. *@
@model IEnumerable<XFLCSMS.Models.Register.User>
@{
    ViewData["Title"] = "Users";
    var rows = Model.OrderBy(user => user.FullName).ToList();
    var me = ViewBag.Profile as XFLCSMS.Models.Register.User;
}
<header class="page-head">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-sub">People register themselves and start as Maker. Change the role or disable an account from here.</p>
    </div>
</header>

<div class="card flush">
    <div class="toolbar">
        <div class="input-wrap">
            <icon name="search" />
            <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter by name, email, role or status" aria-label="Filter users" autocomplete="off">
        </div>
        <span class="spacer"></span>
        <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
    </div>
    <div class="table-wrap">
        <table class="table" id="issuesTable">
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Account</th>
                    <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in rows)
                {
                    <tr>
                        <td>@Ui.Person(item.FullName, item.UserName)</td>
                        <td>@item.Email</td>
                        <td>@Ui.RolePill(Ui.RoleOf(item))</td>
                        <td>
                            @if (!item.UStatus)
                            {
                                @Ui.Pill("st-disabled", "Disabled")
                            }
                            else if (item.VerifiedAt == null)
                            {
                                @Ui.Pill("st-pending", "Not verified")
                            }
                            else
                            {
                                @Ui.Pill("st-active", "Active")
                            }
                        </td>
                        <td class="t-actions">
                            <a class="btn btn-icon btn-sm" asp-action="UserView" asp-route-id="@item.Id" title="View" aria-label="View @item.FullName"><icon name="eye" /></a>
                            <a class="btn btn-icon btn-sm" asp-action="EditUser" asp-route-id="@item.Id" title="Edit role" aria-label="Edit @item.FullName"><icon name="pencil" /></a>
                            @if (me == null || item.Id != me.Id)
                            {
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.FullName"
                                        data-delete data-url="@Url.Action("DeleteUser", new { id = item.Id })" data-issue-id="@item.Id"
                                        data-confirm="Delete @item.FullName?" data-confirm-text="Users who have raised tickets cannot be deleted. Disable them instead.">
                                    <icon name="trash-2" />
                                </button>
                            }
                        </td>
                    </tr>
                }
                <tr data-empty hidden><td colspan="5" class="muted">Nothing matches the filter.</td></tr>
            </tbody>
        </table>
    </div>
</div>
