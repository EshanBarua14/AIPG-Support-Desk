@* One user, read-only. *@
@model XFLCSMS.Models.Admin.UserView
@{
    ViewData["Title"] = Model.FullName;
    ViewData["PageClass"] = "narrow";
    var roleName = Ui.RoleOf(Model.UCatagory, Model.UType, Model.Department);
}
<a class="back" asp-action="UserList"><icon name="arrow-left" /> Users</a>

<header class="page-head">
    <div class="row" style="gap: 16px; flex-wrap: nowrap">
        <span class="avatar lg" aria-hidden="true">@Ui.Initials(Model.FullName)</span>
        <div>
            <h1 class="page-title">@Model.FullName</h1>
            <p class="page-sub">@Ui.RolePill(roleName) @Ui.Pill(Model.UStatus ? "st-active" : "st-disabled", Model.UStatus ? "Active" : "Disabled")</p>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditUser" asp-route-id="@Model.Id"><icon name="pencil" /> Edit role</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>User ID</dt>
            <dd>@Model.Id</dd>
            <dt>User name</dt>
            <dd>@Model.UserName</dd>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
            <dt>Phone</dt>
            <dd>@Model.PhonNumber</dd>
            <dt>Employee ID</dt>
            <dd>@Model.EmployeeId</dd>
            <dt>Brokerage house</dt>
            <dd>@Model.BrokerageHouseName</dd>
            <dt>Branch</dt>
            <dd>@Model.Branch</dd>
            <dt>Designation</dt>
            <dd class="@(string.IsNullOrEmpty(Model.Designation) ? "none" : "")">@(string.IsNullOrEmpty(Model.Designation) ? "Not set" : Model.Designation)</dd>
            <dt>Team</dt>
            <dd>@(Model.UType ? "XFL staff" : "Brokerage house user")</dd>
            <dt>Position</dt>
            <dd class="@(string.IsNullOrEmpty(Model.Department) ? "none" : "")">@(string.IsNullOrEmpty(Model.Department) ? "Not set" : Model.Department == "Support Maneger" ? "Support Manager" : Model.Department)</dd>
            <dt>Administrator</dt>
            <dd>@(Model.UCatagory ? "Yes" : "No")</dd>
        </dl>
    </div>
</section>
