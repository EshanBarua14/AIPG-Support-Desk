@model XFLCSMS.Models.Branch.BranchView
@{
    ViewData["Title"] = Model.BranchName;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="BranchList"><icon name="arrow-left" /> Branches</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.BranchName</h1>
        <p class="page-sub">Branch</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditBranch" asp-route-id="@Model.BranchId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.BranchId</dd>
            <dt>Branch</dt>
            <dd>@Model.BranchName</dd>
            <dt>Brokerage house</dt>
            <dd>@Model.BrokerageHouseName</dd>
        </dl>
    </div>
</section>
