@model XFLCSMS.Models.Register.Verify
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset your password";
}
<h2>Reset your password</h2>
<p class="lead">We email a reset token to the address on your account. The token works for 24 hours.</p>

<partial name="_Messages" />

<form asp-controller="RegisterLogin" asp-action="ForgotPassword" method="post">
    <div class="field">
        <label for="Email">Email or user name</label>
        <div class="input-wrap">
            <icon name="mail" />
            <input class="input" type="text" asp-for="Email" required autofocus autocapitalize="none" spellcheck="false">
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Email me a reset token</button>
</form>

<div class="auth-links">
    <span>Already have a token? <a asp-action="ResetPassword">Set a new password</a></span>
    <a asp-action="Login">Back to sign in</a>
</div>
