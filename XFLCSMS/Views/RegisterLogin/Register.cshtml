@model XFLCSMS.Models.Register.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
    ViewData["CardClass"] = "wide";
    var houses = Model.Brokerages ?? new List<XFLCSMS.Models.Brocarage.Brokerage>();
    var branches = Model.Branchhs ?? new List<XFLCSMS.Models.Branch.Branchh>();
    var chosenHouse = Model.userRegisterRequest?.BrokerageHouseName ?? 0;
    var chosenBranch = Model.userRegisterRequest?.Branch ?? 0;
}
<h2>Register an account</h2>
<p class="lead">For staff of brokerage houses that use AIPG systems. We email you a token to activate the account.</p>

<partial name="_Messages" />
@if (houses.Count == 0)
{
    <div class="alert alert-warning" role="status"><icon name="triangle-alert" /><span>No brokerage house is set up yet, so nobody can register. Ask the AIPG support team to add yours.</span></div>
}

<form asp-controller="RegisterLogin" asp-action="Register" method="post" id="form1">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-section">About you</div>
    <div class="form-grid">
        <div class="field wide">
            <label for="fullname">Full name</label>
            <input class="input" asp-for="userRegisterRequest.FullName" id="fullname" required maxlength="100" autocomplete="name">
            <span asp-validation-for="userRegisterRequest.FullName"></span>
        </div>
        <div class="field">
            <label for="email">Email</label>
            <input class="input" type="email" asp-for="userRegisterRequest.Email" id="email" required autocomplete="email">
            <span asp-validation-for="userRegisterRequest.Email"></span>
        </div>
        <div class="field">
            <label for="PhonNumber">Phone</label>
            <input class="input" type="tel" asp-for="userRegisterRequest.PhonNumber" id="PhonNumber" required pattern="[0-9+\-]+" title="Digits, + and - only" autocomplete="tel">
            <span asp-validation-for="userRegisterRequest.PhonNumber"></span>
        </div>
    </div>

    <div class="auth-section">Where you work</div>
    <div class="form-grid">
        <div class="field">
            <label for="brokerageCodes">Organization</label>
            <select class="select" name="userRegisterRequest.BrokerageHouseName" id="brokerageCodes" required>
                <option value="">Choose your brokerage house</option>
                @foreach (var house in houses)
                {
                    <option value="@house.BrokerageId" data-acronym="@house.BrokerageHouseAcronym" selected="@(house.BrokerageId == chosenHouse)">@house.BrokerageHouseName</option>
                }
            </select>
            <span class="hint" id="Acronym">@(string.IsNullOrEmpty(Model.Acronyme) ? "" : "Ticket numbers will start with " + Model.Acronyme)</span>
            <span asp-validation-for="userRegisterRequest.BrokerageHouseName"></span>
        </div>
        <div class="field">
            <label for="Branch">Branch</label>
            <select class="select" name="userRegisterRequest.Branch" id="Branch" required>
                <option value="">@(branches.Count == 0 ? "Choose the organization first" : "Choose your branch")</option>
                @foreach (var branch in branches)
                {
                    <option value="@branch.BranchId" selected="@(branch.BranchId == chosenBranch)">@branch.BranchName</option>
                }
            </select>
            <span class="hint" id="BranchHint" hidden>Ask the AIPG support team to add your branch. You cannot register without one.</span>
            <span asp-validation-for="userRegisterRequest.Branch"></span>
        </div>
        <div class="field">
            <label for="EmployeeId">Employee ID</label>
            <input class="input" asp-for="userRegisterRequest.EmployeeId" id="EmployeeId" required maxlength="15">
            <span asp-validation-for="userRegisterRequest.EmployeeId"></span>
        </div>
    </div>

    <div class="auth-section">Sign-in details</div>
    <div class="form-grid">
        <div class="field wide">
            <label for="Username">User name</label>
            <input class="input" asp-for="userRegisterRequest.UserName" id="Username" required minlength="5" maxlength="25" pattern="[^\s&#64;]+" title="No spaces and no &#64;" autocomplete="username" autocapitalize="none" spellcheck="false">
            <span class="hint">5 to 25 characters, no spaces. You can also sign in with your email.</span>
            <span asp-validation-for="userRegisterRequest.UserName"></span>
        </div>
        <div class="field">
            <label for="password">Password</label>
            <div class="input-wrap">
                <input class="input" type="password" name="userRegisterRequest.Password" id="password" required minlength="@XFLCSMS.Services.PasswordPolicy.MinimumLength" maxlength="@XFLCSMS.Services.PasswordPolicy.MaximumLength" autocomplete="new-password">
                <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
            </div>
            <span class="hint">@XFLCSMS.Services.PasswordPolicy.Hint</span>
            <span asp-validation-for="userRegisterRequest.Password"></span>
        </div>
        <div class="field">
            <label for="Confirmpassword">Password again</label>
            <div class="input-wrap">
                <input class="input" type="password" name="userRegisterRequest.ConfirmPassword" id="Confirmpassword" required data-match="#password" autocomplete="new-password">
                <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
            </div>
            <span asp-validation-for="userRegisterRequest.ConfirmPassword"></span>
        </div>
    </div>

    <div class="field">
        <label class="check">
            <input type="checkbox" name="userRegisterRequest.Terms" id="Terms" value="true" required checked="@(Model.userRegisterRequest?.Terms == true)">
            <span>I agree to the terms and conditions of AIPG support.</span>
        </label>
        <span asp-validation-for="userRegisterRequest.Terms"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-block">Register</button>
</form>

<div class="auth-links">
    <span>Already registered? <a asp-action="Login">Sign in</a></span>
</div>

@section Scripts {
    <script>
        // the branch list depends on the chosen brokerage house
        (function () {
            var house = document.getElementById('brokerageCodes');
            var branch = document.getElementById('Branch');
            var note = document.getElementById('Acronym');
            var noBranch = document.getElementById('BranchHint');
            house.addEventListener('change', function () {
                var option = house.options[house.selectedIndex];
                var acronym = option ? option.getAttribute('data-acronym') : '';
                note.textContent = acronym ? 'Ticket numbers will start with ' + acronym : '';
                branch.innerHTML = '<option value="">' + (house.value ? 'Loading branches...' : 'Choose the organization first') + '</option>';
                noBranch.hidden = true;
                if (!house.value) { return; }
                fetch('@Url.Action("GetBranches", "RegisterLogin")?brokerageId=' + encodeURIComponent(house.value), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) { return response.json(); })
                    .then(function (branches) {
                        branch.innerHTML = '<option value="">' + (branches.length ? 'Choose your branch' : 'This organization has no branches yet') + '</option>';
                        noBranch.hidden = branches.length > 0;
                        branches.forEach(function (item) {
                            var entry = document.createElement('option');
                            entry.value = item.branchId;
                            entry.textContent = item.branchName;
                            branch.appendChild(entry);
                        });
                    })
                    .catch(function () {
                        branch.innerHTML = '<option value="">Could not load the branches. Choose the organization again.</option>';
                    });
            });
        })();
    </script>
}
