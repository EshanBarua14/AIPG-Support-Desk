@model XFLCSMS.Models.Login.ResetPasswordRequest
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set a new password";
}
<h2>Set a new password</h2>
<p class="lead">Enter the token from the reset email and choose a new password.</p>

<partial name="_Messages" />

<form asp-controller="RegisterLogin" asp-action="ResetPassword" method="post" autocomplete="off">
    <div class="field">
        <label for="token">Token</label>
        <div class="input-wrap">
            <icon name="key-round" />
            <input class="input" type="text" name="Token" id="token" value="@Model?.Token" required autofocus autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" style="font-family: var(--font-mono); letter-spacing: .12em">
        </div>
    </div>
    <div class="field">
        <label for="password">New password</label>
        <div class="input-wrap">
            <icon name="lock" />
            <input class="input" type="password" name="Password" id="password" required minlength="6" autocomplete="new-password">
            <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
        </div>
        <span class="hint">At least 6 characters.</span>
    </div>
    <div class="field">
        <label for="Confirmpassword">New password again</label>
        <div class="input-wrap">
            <icon name="lock" />
            <input class="input" type="password" name="ConfirmPassword" id="Confirmpassword" required data-match="#password" autocomplete="new-password">
            <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Change password</button>
</form>

<div class="auth-links">
    <a asp-action="Login">Back to sign in</a>
</div>
