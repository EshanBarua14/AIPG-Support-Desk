@model XFLCSMS.Models.Register.Verify
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Activate your account";
}
<h2>Activate your account</h2>
<p class="lead">Enter the token from the registration email. It looks like A1B2C3.</p>

<partial name="_Messages" />

<form asp-controller="RegisterLogin" asp-action="Verify" method="post">
    <div class="field">
        <label for="Email">Email or user name</label>
        <div class="input-wrap">
            <icon name="user" />
            <input class="input" type="text" asp-for="Email" required autofocus autocapitalize="none" spellcheck="false">
        </div>
    </div>
    <div class="field">
        <label for="Token">Token</label>
        <div class="input-wrap">
            <icon name="key-round" />
            <input class="input" type="text" asp-for="Token" required autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" style="font-family: var(--font-mono); letter-spacing: .12em">
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Activate account</button>
</form>

<div class="auth-links">
    <a asp-action="Login">Back to sign in</a>
</div>
