@model IEnumerable<XFLCSMS.Models.Affected.AffectedSection>
@{
    ViewData["Title"] = "Affected sections";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Affected sections</h1>
        <p class="page-sub">The part of the system a ticket is about.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateAffectedSection"><icon name="plus" /> New affected section</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No affected sections yet</b>
            <div><a class="btn btn-primary" asp-action="CreateAffectedSection"><icon name="plus" /> New affected section</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter affected sections" aria-label="Filter affected sections" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Product</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.AffectedSectionId">
                            <td class="t-id">@item.AffectedSectionId</td>
                        <td class="c-title"><span class="t-title">@item.ASection</span></td>
                        <td><partial name="_ProductName" model="item.Product" /></td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewAffectedSection" asp-route-id="@item.AffectedSectionId" title="View" aria-label="View @item.ASection"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditAffectedSection" asp-route-id="@item.AffectedSectionId" title="Edit" aria-label="Edit @item.ASection"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.ASection"
                                        data-delete data-url="@Url.Action("DeleteAffectedSection", new { id = item.AffectedSectionId })"
                                        data-confirm="Delete @item.ASection?" data-confirm-text="A section that tickets use cannot be deleted." data-issue-id="@item.AffectedSectionId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="4" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
