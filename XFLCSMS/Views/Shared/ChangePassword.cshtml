@* Change the password of the signed-in user. Afterwards the user signs in again. *@
@model XFLCSMS.Models.Register.Password
@{
    ViewData["Title"] = "Change password";
    ViewData["PageClass"] = "narrow";
}
<header class="page-head">
    <div>
        <h1 class="page-title">Change password</h1>
        <p class="page-sub">After the change you are signed out and sign in again with the new password.</p>
    </div>
</header>

@if (ViewBag.message != null)
{
    <div class="alert alert-danger" role="alert"><icon name="circle-alert" /><span>@ViewBag.message</span></div>
}

<form class="card" asp-action="ChangePassword" method="post" autocomplete="off">
    <div class="card-body stack" style="max-width: 460px">
        <div class="field">
            <label for="password">Current password</label>
            <div class="input-wrap">
                <input class="input" type="password" name="CurrentPassword" id="password" required autocomplete="current-password">
                <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
            </div>
        </div>
        <div class="field">
            <label for="Newpassword">New password</label>
            <div class="input-wrap">
                <input class="input" type="password" name="NewPassword" id="Newpassword" required minlength="4" autocomplete="new-password">
                <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
            </div>
            <span class="hint">At least one small letter, one capital letter, one digit and one of @@ $ ! % * ? &amp;</span>
        </div>
        <div class="field">
            <label for="Confirmpassword">New password again</label>
            <div class="input-wrap">
                <input class="input" type="password" name="ConNewPassword" id="Confirmpassword" required data-match="#Newpassword" autocomplete="new-password">
                <button type="button" class="btn btn-icon btn-sm peek" data-peek aria-label="Show password"><icon name="eye" /></button>
            </div>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="key-round" /> Change password</button>
        <a class="btn" asp-action="Profile">Cancel</a>
    </div>
</form>
