@model XFLCSMS.Models.Branch.BranchView
@{
    ViewData["Title"] = "New branch";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="BranchList"><icon name="arrow-left" /> Branches</a>

<header class="page-head">
    <div>
        <h1 class="page-title">New branch</h1>
    </div>
</header>

<form class="card" asp-action="CreateBranch" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field">
            <label asp-for="BranchName">Branch name</label>
            <input class="input" asp-for="BranchName" placeholder="For example: Motijheel" autocomplete="off" required>
            <span class="hint">Letters, spaces and dots.</span>
            <span asp-validation-for="BranchName"></span>
        </div>
        <div class="field">
            <label asp-for="BrokerageId">Brokerage house</label>
            <select class="select" asp-for="BrokerageId" required>
                <option value="">Choose a house</option>
                @foreach (var house in Model.brocarage ?? new List<XFLCSMS.Models.Brocarage.Brokerage>())
                {
                    <option value="@house.BrokerageId">@house.BrokerageHouseName</option>
                }
            </select>
            <span asp-validation-for="BrokerageId"></span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Create branch</button>
        <a class="btn" asp-action="BranchList">Cancel</a>
    </div>
</form>
