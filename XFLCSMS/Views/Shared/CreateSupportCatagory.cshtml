@model XFLCSMS.Models.Support.SupportCatagory
@{
    ViewData["Title"] = "New support category";
    ViewData["PageClass"] = "narrow";
}
<partial name="_SupportListBack" model='(Model?.ProductId, "SupportCatagoryList", "Support categories", false)' />

<header class="page-head">
    <div>
        <h1 class="page-title">New support category</h1>
    </div>
</header>

<form class="card" asp-action="CreateSupportCatagory" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field">
            <label asp-for="SCatagory">Name</label>
            <input class="input" asp-for="SCatagory" placeholder="For example: Software" autocomplete="off" required>
            <span class="hint">@XFLCSMS.Models.Support.SupportListRules.Hint</span>
            <span asp-validation-for="SCatagory"></span>
        </div>
        <partial name="_ProductChoice" model="Model?.ProductId" />
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Create support category</button>
        <partial name="_SupportListBack" model='(Model?.ProductId, "SupportCatagoryList", "Cancel", true)' />
    </div>
</form>
