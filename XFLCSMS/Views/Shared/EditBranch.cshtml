@model XFLCSMS.Models.Branch.BranchView
@{
    ViewData["Title"] = "Edit branch";
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="BranchList"><icon name="arrow-left" /> Branches</a>

<header class="page-head">
    <div>
        <h1 class="page-title">Edit branch</h1>
    </div>
</header>

<form class="card" asp-action="UpdateBranch" method="post">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="BranchId">
        <div class="field">
            <label asp-for="BranchName">Branch name</label>
            <input class="input" asp-for="BranchName" placeholder="For example: Motijheel" autocomplete="off" required>
            <span class="hint">Letters, spaces and dots.</span>
            <span asp-validation-for="BranchName"></span>
        </div>
        <div class="field">
            <label asp-for="BrokerageHouseName">Brokerage house</label>
            <input class="input" asp-for="BrokerageHouseName" readonly>
            <span class="hint">A branch stays with its house. To move it, delete it and create it under the other house.</span>
        </div>
    </div>
    <div class="card-foot">
        <button type="submit" class="btn btn-primary"><icon name="save" /> Save changes</button>
        <a class="btn" asp-action="BranchList">Cancel</a>
    </div>
</form>
