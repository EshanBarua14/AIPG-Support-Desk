@* Shown when something failed on the server. It has no layout on purpose: it must work without a session. *@
@model XFLCSMS.Models.ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Something went wrong - XFL CSMS</title>
    <partial name="_Theme" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>
<body>
    <main class="error-page">
        <div class="card">
            <icon name="triangle-alert" />
            <h1>Something went wrong</h1>
            <p>The page could not be completed. Go back and try again. If it keeps happening, tell the XFL team what you were doing.</p>
            @if (Model != null && Model.ShowRequestId)
            {
                <p class="small muted">Request ID: <code>@Model.RequestId</code></p>
            }
            <div class="row" style="justify-content: center">
                <a class="btn" href="javascript:history.back()"><icon name="arrow-left" /> Go back</a>
                <a class="btn btn-primary" href="~/">Start page</a>
            </div>
        </div>
    </main>
</body>
</html>
