@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>XFL CSMS | Error</title>
    <link rel="stylesheet" href="~/css/all.min.css">
    <link rel="stylesheet" href="~/css/adminlte.min.css">
</head>
<body class="hold-transition">
    <div class="container mt-5">
        <div class="card card-outline card-danger">
            <div class="card-body">
                <h1 class="text-danger">Something went wrong.</h1>
                <p>An error occurred while processing your request. Nothing was lost on your account; please go back and try again.</p>
                @if (Model != null && Model.ShowRequestId)
                {
                    <p>
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a>
                <a href="~/" class="btn btn-outline-primary">Sign-in page</a>
            </div>
        </div>
    </div>
</body>
</html>
