@*
    Service report: how fast XFL answered and solved the tickets of a period, how many service targets were met,
    what people thought of the support, and what is open right now. Times are working time (see Service targets).
    XFL roles see every brokerage house or one of them; a house admin sees the own house.
*@
@model XFLCSMS.Models.Desk.ServiceReport
@{
    ViewData["Title"] = "Service report";
    var role = Ui.Role(ViewContext);
    var periods = new[] { (7, "7 days"), (30, "30 days"), (90, "90 days"), (365, "12 months") };
    var periodName = periods.First(period => period.Item1 == Model.Days).Item2;
    var peak = Math.Max(1, Model.Trend.Count == 0 ? 1 : Model.Trend.Max(point => Math.Max(point.Raised, point.Solved)));
    // a clean top for the scale: 4, 8, 12, 20, 40 ...
    var top = new[] { 4, 8, 12, 20, 40, 60, 80, 120, 200, 400, 800, 1200, 2000, 4000 }.FirstOrDefault(step => step >= peak);
    if (top == 0) { top = peak; }
    var backlogMax = Math.Max(1, Model.Backlog.Count == 0 ? 1 : Model.Backlog.Max(item => item.Count));
    var ratingMax = Math.Max(1, Model.RatingCounts.Max());
    string Rate(double? value) => value == null ? "-" : value.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    // every label when there are few columns, every nth otherwise, so they never run into each other
    var labelEvery = Model.Trend.Count <= 10 ? 1 : Model.Trend.Count <= 20 ? 2 : (int)Math.Ceiling(Model.Trend.Count / 8.0);
}
<header class="page-head">
    <div>
        <h1 class="page-title">Service report</h1>
        <p class="page-sub">
            Tickets raised in the last @periodName@(Model.HouseName != null ? ", " + Model.HouseName : role.IsStaff ? ", all brokerage houses" : "")@(Model.OwnWorkOnly ? ", assigned to you" : "").
            Times are working time.
        </p>
    </div>
</header>

<form class="report-filters" method="get" asp-action="ServiceReport">
    <div class="seg" role="group" aria-label="Period">
        @foreach (var period in periods)
        {
            <a class="@(period.Item1 == Model.Days ? "on" : "")" asp-action="ServiceReport" asp-route-days="@period.Item1" asp-route-house="@(Model.HouseId > 0 && role.IsStaff ? (int?)Model.HouseId : null)"
               aria-current="@(period.Item1 == Model.Days ? "true" : null)">@period.Item2</a>
        }
    </div>
    @if (Model.Houses.Count > 0)
    {
        <input type="hidden" name="days" value="@Model.Days">
        <label class="sr-only" for="reportHouse">Brokerage house</label>
        <select class="select" name="house" id="reportHouse" data-auto-submit>
            <option value="0">All brokerage houses</option>
            @foreach (var house in Model.Houses)
            {
                <option value="@house.BrokerageId" selected="@(house.BrokerageId == Model.HouseId)">@house.BrokerageHouseName</option>
            }
        </select>
        <noscript><button type="submit" class="btn">Show</button></noscript>
    }
</form>

<div class="stack">
    <section class="card" aria-label="Key figures">
        <div class="card-body tiles">
            <div class="tile">
                <span class="tile-label">First response, half of the tickets within</span>
                <b class="tile-value">@SlaService.Hours(Model.MedianResponse)</b>
                <span class="tile-note">@(Model.ResponseMet.Of == 0 ? "No ticket with a response target yet" : Model.ResponseMet.Met + " of " + Model.ResponseMet.Of + " answered in time")</span>
            </div>
            <div class="tile">
                <span class="tile-label">Solved, half of the tickets within</span>
                <b class="tile-value">@SlaService.Hours(Model.MedianResolve)</b>
                <span class="tile-note">@(Model.ResolveMet.Of == 0 ? "No ticket with a solution target yet" : Model.ResolveMet.Met + " of " + Model.ResolveMet.Of + " solved in time")</span>
            </div>
            <div class="tile">
                <span class="tile-label">Rating</span>
                <b class="tile-value">@Rate(Model.AverageRating)<small>@(Model.AverageRating == null ? "" : " of 5")</small></b>
                <span class="tile-note">@(Model.Ratings == 0 ? "Nobody has rated yet" : Model.Ratings + (Model.Ratings == 1 ? " rating" : " ratings"))</span>
            </div>
            <div class="tile">
                <span class="tile-label">Raised</span>
                <b class="tile-value">@Model.Raised</b>
                <span class="tile-note">@Model.Solved solved@(Model.Reopened > 0 ? ", " + Model.Reopened + " reopened" : "")</span>
            </div>
            <div class="tile">
                <span class="tile-label">Open now</span>
                <b class="tile-value">@Model.OpenNow</b>
                <span class="tile-note">
                    @if (Model.OverdueNow > 0)
                    {
                        <a asp-action="OverdueTicketList"><span class="pill sla sla-overdue">@Model.OverdueNow overdue</span></a>
                    }
                    else
                    {
                        <text>None overdue</text>
                    }
                </span>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-head"><h2>Raised and solved</h2><span class="sub">Per @(Model.TrendIsWeekly ? "week" : "day")</span></div>
        <div class="card-body">
            @if (Model.Raised == 0 && Model.Trend.All(point => point.Solved == 0))
            {
                <p class="muted" style="margin: 0">No ticket was raised or solved in this period.</p>
            }
            else
            {
                <div class="legend" style="margin: 0 0 14px">
                    <span><i class="s-open"></i>Raised</span>
                    <span><i class="s-closed"></i>Solved</span>
                </div>
                <div class="cols" role="img" aria-label="Tickets raised and solved per @(Model.TrendIsWeekly ? "week" : "day"). The table below has the numbers." style="--cols: @Model.Trend.Count">
                    <div class="cols-scale" aria-hidden="true"><span>@top</span><span>@(top / 2)</span><span>0</span></div>
                    <div class="cols-plot">
                        @for (var index = 0; index < Model.Trend.Count; index++)
                        {
                            var point = Model.Trend[index];
                            <div class="col" tabindex="0" data-tip="@point.Label: @point.Raised raised, @point.Solved solved">
                                <div class="col-bars">
                                    <i class="s-open" style="height: @((100.0 * point.Raised / top).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i>
                                    <i class="s-closed" style="height: @((100.0 * point.Solved / top).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i>
                                </div>
                                <span class="col-label">@(index % labelEvery == 0 ? point.Label : "")</span>
                            </div>
                        }
                    </div>
                </div>
                <details class="as-table">
                    <summary>Show the numbers as a table</summary>
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th scope="col">@(Model.TrendIsWeekly ? "Week from" : "Day")</th><th scope="col" class="t-right">Raised</th><th scope="col" class="t-right">Solved</th></tr></thead>
                            <tbody>
                                @foreach (var point in Model.Trend)
                                {
                                    <tr><th scope="row">@point.Label</th><td class="t-right num">@point.Raised</td><td class="t-right num">@point.Solved</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </section>

    <section class="card flush">
        <div class="card-head"><h2>By priority</h2><span class="sub">Targets met counts tickets whose target is decided: reached, or passed</span></div>
        <partial name="_ServiceRows" model="@(("Priority", Model.ByPriority))" />
    </section>

    <div class="report-pair">
        <section class="card">
            <div class="card-head"><h2>Open tickets by age</h2><span class="sub">@Model.OpenNow open now</span></div>
            <div class="card-body">
                @if (Model.OpenNow == 0)
                {
                    <p class="muted" style="margin: 0">Nothing is open.</p>
                }
                else
                {
                    <div class="hbars">
                        @foreach (var bucket in Model.Backlog)
                        {
                            <span class="name">@bucket.Name</span>
                            <span class="bar" title="@bucket.Count open, raised @bucket.Name.ToLowerInvariant() ago">@if (bucket.Count > 0) { <i class="s-open" style="width: @((100.0 * bucket.Count / backlogMax).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i> }</span>
                            <span class="val">@bucket.Count</span>
                        }
                    </div>
                    <p class="muted" style="margin: 14px 0 0">@Model.WaitingForResponse of them @(Model.WaitingForResponse == 1 ? "has" : "have") not been answered yet.</p>
                }
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>Ratings</h2><span class="sub">@(Model.Ratings == 0 ? "None yet" : Rate(Model.AverageRating) + " of 5 on average")</span></div>
            <div class="card-body">
                @if (Model.Ratings == 0)
                {
                    <p class="muted" style="margin: 0">When a ticket is closed, the person who raised it is asked how the support was. The answers appear here.</p>
                }
                else
                {
                    <div class="hbars">
                        @for (var value = 5; value >= 1; value--)
                        {
                            var count = Model.RatingCounts[value - 1];
                            <span class="name">@value @(value == 5 ? "very good" : value == 1 ? "bad" : "")</span>
                            <span class="bar" title="@count @(count == 1 ? "ticket was" : "tickets were") rated @value">@if (count > 0) { <i class="s-open" style="width: @((100.0 * count / ratingMax).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i> }</span>
                            <span class="val">@count</span>
                        }
                    </div>
                }
            </div>
        </section>
    </div>

    @if (Model.ByProduct.Count > 0)
    {
        <section class="card flush">
            <div class="card-head"><h2>By product</h2><span class="sub">Tickets of the period by the product they were raised for</span></div>
            <partial name="_ServiceRows" model="@(("Product", Model.ByProduct))" />
        </section>
    }

    @if (Model.ByEngineer.Count > 0)
    {
        <section class="card flush">
            <div class="card-head"><h2>By engineer</h2><span class="sub">Tickets of the period by who holds them now</span></div>
            <partial name="_ServiceRows" model="@(("Engineer", Model.ByEngineer))" />
        </section>
    }

    @if (Model.ByHouse.Count > 1)
    {
        <section class="card flush">
            <div class="card-head"><h2>By brokerage house</h2></div>
            <partial name="_ServiceRows" model="@(("Brokerage house", Model.ByHouse))" />
        </section>
    }
</div>
