@model IEnumerable<XFLCSMS.Models.Support.SupportSubCatagory>
@{
    ViewData["Title"] = "Support sub-categories";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Support sub-categories</h1>
        <p class="page-sub">The third choice on the ticket form.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateSupportSubCatagory"><icon name="plus" /> New support sub-category</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No support sub-categories yet</b>
            <div><a class="btn btn-primary" asp-action="CreateSupportSubCatagory"><icon name="plus" /> New support sub-category</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter support sub-categories" aria-label="Filter support sub-categories" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Name</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.SupportSubCatagoryId">
                            <td class="t-id">@item.SupportSubCatagoryId</td>
                        <td class="c-title"><span class="t-title">@item.SubCatagory</span></td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewSupportSubCatagory" asp-route-id="@item.SupportSubCatagoryId" title="View" aria-label="View @item.SubCatagory"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditSupportSubCatagory" asp-route-id="@item.SupportSubCatagoryId" title="Edit" aria-label="Edit @item.SubCatagory"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.SubCatagory"
                                        data-delete data-url="@Url.Action("DeleteSupportSubCatagory", new { id = item.SupportSubCatagoryId })"
                                        data-confirm="Delete @item.SubCatagory?" data-confirm-text="A sub-category that tickets use cannot be deleted." data-issue-id="@item.SupportSubCatagoryId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="3" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
