@model IEnumerable<XFLCSMS.Models.Support.SupportType>
@{
    ViewData["Title"] = "Support types";
    var rows = Model.ToList();
}
<header class="page-head">
    <div>
        <h1 class="page-title">Support types</h1>
        <p class="page-sub">The first choice on the ticket form: what kind of help is needed.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateSupportType"><icon name="plus" /> New support type</a>
    </div>
</header>

<div class="card flush">
    @if (rows.Count == 0)
    {
        <div class="empty">
            <icon name="layers" />
            <b>No support types yet</b>
            <div><a class="btn btn-primary" asp-action="CreateSupportType"><icon name="plus" /> New support type</a></div>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="input-wrap">
                <icon name="search" />
                <input class="input" type="search" data-filter="#issuesTable" data-count="#shownCount" placeholder="Filter support types" aria-label="Filter support types" autocomplete="off">
            </div>
            <span class="spacer"></span>
            <span class="muted small num"><span id="shownCount">@rows.Count</span> of <span data-total>@rows.Count</span></span>
        </div>
        <div class="table-wrap">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Product</th>
                        <th scope="col" class="t-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr id="row-@item.SupportTypeId">
                            <td class="t-id">@item.SupportTypeId</td>
                        <td class="c-title"><span class="t-title">@item.SType</span></td>
                        <td><partial name="_ProductName" model="item.Product" /></td>
                            <td class="t-actions">
                                <a class="btn btn-icon btn-sm" asp-action="ViewSupportType" asp-route-id="@item.SupportTypeId" title="View" aria-label="View @item.SType"><icon name="eye" /></a>
                                <a class="btn btn-icon btn-sm" asp-action="EditSupportType" asp-route-id="@item.SupportTypeId" title="Edit" aria-label="Edit @item.SType"><icon name="pencil" /></a>
                                <button type="button" class="btn btn-icon btn-sm danger" title="Delete" aria-label="Delete @item.SType"
                                        data-delete data-url="@Url.Action("DeleteSupportType", new { id = item.SupportTypeId })"
                                        data-confirm="Delete @item.SType?" data-confirm-text="A type that tickets use cannot be deleted." data-issue-id="@item.SupportTypeId">
                                    <icon name="trash-2" />
                                </button>
                            </td>
                        </tr>
                    }
                    <tr data-empty hidden><td colspan="4" class="muted">Nothing matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
