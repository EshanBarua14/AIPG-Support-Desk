@*
    One ticket. Everybody who may open it sees the same page; what can be done from it (edit, assign, take,
    give back) depends on the role and on who holds the ticket (Model.CanEdit, role.Can(...)).
*@
@model XFLCSMS.Models.Issue.MakerView
@{
    var role = Ui.Role(ViewContext);
    ViewData["Title"] = "Ticket " + Model.TicketNumber;
    var status = TicketStatus.Normalize(Model.IStatus);
    var closed = status == TicketStatus.Closed;
    var assigned = !string.IsNullOrEmpty(Model.AssgnBy);
    var allFiles = Model.Attachments?.ToList() ?? new List<XFLCSMS.Models.Issue.Attachment>();
    // files of the ticket itself; what came with a conversation entry is shown with that entry
    var attachments = allFiles.Where(file => file.MessageId == null).ToList();
    var filesOf = allFiles.Where(file => file.MessageId != null).ToLookup(file => file.MessageId!.Value);
    var me = ViewBag.Profile as XFLCSMS.Models.Register.User;
    var firstName = (Model.CreatedBy ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
    var hasTargets = Model.ResponseClock.Due != null || Model.ResolveClock.Due != null;
    var canAssign = role.Can(Permission.TicketAssign) && !closed;
    var canTake = role.Can(Permission.TicketTake) && !closed;
    var engineers = canAssign ? ((Lazy<List<XFLCSMS.Models.Admin.EngineerLoad>>)ViewBag.EngineerChoices).Value : new List<XFLCSMS.Models.Admin.EngineerLoad>();
    var currentEngineer = Model.AssignedToId ?? engineers.Where(e => e.Name == Model.AssgnBy).Select(e => (int?)e.Id).FirstOrDefault();

    // Where the ticket stands. "Pending" is no step of its own: it is work that has stopped for a while.
    var rank = status == TicketStatus.Closed ? 6 : status == TicketStatus.Deployed ? 5 : status == TicketStatus.Done ? 4
        : status == TicketStatus.Review ? 3 : status == TicketStatus.InProgress || status == TicketStatus.Pending ? 2 : assigned ? 1 : 0;
    var steps = new List<(string Name, string Note)>
    {
        ("Raised", Ui.Date(Model.CreatedOn)),
        ("Assigned", assigned ? Model.AssgnBy! : "Waiting for an engineer"),
        ("In progress", status == TicketStatus.Pending ? "On hold: pending" : rank == 2 ? "Being worked on" : rank > 2 ? "Worked on" : "Not started"),
        ("Waiting for review", rank == 3 ? "To be checked" : rank > 3 ? "Checked" : string.Empty),
        ("Done", rank == 4 ? "Accepted, not live yet" : string.Empty),
        ("Deployed", rank == 5 ? "Live" : string.Empty),
        ("Closed", closed ? Ui.Date(Model.CloseOn) : string.Empty)
    };
    // the step the ticket has reached is "now" until it is closed; everything before it is done
    var choices = Model.StatusChoices;
    // the step that usually comes next gets the emphasis (from Pending: back to work)
    var forward = status == TicketStatus.Pending
        ? choices.Where(choice => choice.Key == TicketStatus.InProgress).Select(choice => choice.Key).FirstOrDefault()
        : choices.Where(choice => Array.IndexOf(TicketStatus.Keys, choice.Key) > Array.IndexOf(TicketStatus.Keys, status) && choice.Key != TicketStatus.Pending).Select(choice => choice.Key).FirstOrDefault();
}
<a class="back" asp-action="@role.TicketList"><icon name="arrow-left" /> @role.TicketListName</a>

<header class="page-head">
    <div>
        <div class="ticket-head">
            @Ui.Sym(Model.TicketNumber, large: true)
            <span id="TicketStatus" data-status="@Model.IStatus">@Ui.StatusPill(Model.IStatus)</span>
            @Ui.PriorityPill(Model.Priority)
        </div>
        <h1 class="page-title">@(string.IsNullOrWhiteSpace(Model.IssueTitle) ? "(no title)" : Model.IssueTitle)</h1>
        <p class="page-sub">Raised by @Model.CreatedBy@(string.IsNullOrEmpty(Model.BrokerageHouse) ? "" : ", " + Model.BrokerageHouse) on @Ui.Stamp(Model.CreatedOn)</p>
    </div>
    @if (Model.CanEdit && (!closed || role.Can(Permission.TicketWorkAny)))
    {
        <div class="page-actions">
            <a class="btn @(choices.Count > 0 ? "" : "btn-primary")" asp-action="EditTicket" asp-route-id="@Model.IssueId"><icon name="pencil" /> Edit ticket</a>
        </div>
    }
</header>

<div class="split">
    <div class="stack">
        <section class="card" aria-label="Progress">
            <div class="card-body">
                <ol class="steps seven">
                    @for (var index = 0; index < steps.Count; index++)
                    {
                        var state = index < rank || closed ? "done" : index == rank ? "now" : "";
                        <li class="@state @(index == 2 && status == TicketStatus.Pending ? "held" : "")" aria-current="@(state == "now" ? "step" : null)">
                            <b>@steps[index].Name</b>@steps[index].Note
                        </li>
                    }
                </ol>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>Details</h2></div>
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.TicketDetails))
                {
                    <p class="muted">No details were given.</p>
                }
                else
                {
                    <div class="prose" id="ticketDetails">@Html.Raw(HtmlSanitizer.Sanitize(Model.TicketDetails))</div>
                }
            </div>
        </section>

        <section class="card" id="conversation">
            <div class="card-head"><h2>Conversation</h2><span class="sub">@Model.Messages.Count @(Model.Messages.Count == 1 ? "entry" : "entries")</span></div>
            <div class="card-body">
                @if (Model.Messages.Count == 0)
                {
                    <p class="muted" style="margin: 0">Nobody has written yet. @(role.IsStaff ? "A reply here is what the brokerage house reads; it also counts as the first response." : "Ask a question or add what you have found out since.")</p>
                }
                else
                {
                    <ol class="thread">
                        @foreach (var message in Model.Messages)
                        {
                            var files = filesOf[message.Id].ToList();
                            <li class="msg @(message.IsInternal ? "is-note" : message.FromStaff ? "from-staff" : "from-house")" id="message-@message.Id">
                                <span class="avatar" aria-hidden="true">@Ui.Initials(message.AuthorName)</span>
                                <div class="msg-main">
                                    <div class="msg-head">
                                        <b>@message.AuthorName</b>
                                        <span>@(message.FromStaff ? "XFL" : "Brokerage house")@(string.IsNullOrEmpty(message.AuthorRole) ? "" : ", " + message.AuthorRole.ToLowerInvariant()) &middot; @Ui.Stamp(message.At)</span>
                                        @if (message.IsInternal)
                                        {
                                            <span class="pill note-pill"><icon name="lock" /> Internal note</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(message.Body))
                                    {
                                        <div class="prose">@Html.Raw(HtmlSanitizer.Sanitize(message.Body))</div>
                                    }
                                    @if (files.Count > 0)
                                    {
                                        <ul class="files msg-files">
                                            @foreach (var file in files)
                                            {
                                                <li class="file">
                                                    <icon name="@Ui.FileIcon(file.FileName)" />
                                                    <span class="file-name">@file.FileName</span>
                                                    <a class="btn btn-sm right" asp-action="DownloadAttachment" asp-route-att="@file.AttachmentId"><icon name="download" /> Download</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>
            <form class="card-body reply" asp-action="ReplyTicket" asp-route-id="@Model.IssueId" method="post" enctype="multipart/form-data" data-reply
                  data-name="@firstName" data-ticket="@Model.TicketNumber" data-me="@me?.FullName">
                @if (closed)
                {
                    <p class="muted" style="margin: 0 0 12px">This ticket is closed. You can still write here; it does not reopen the ticket by itself.</p>
                }
                @if (role.IsStaff && Model.CannedReplies.Count > 0)
                {
                    <div class="field">
                        <label for="cannedReply">Canned reply</label>
                        <select class="select" id="cannedReply" data-canned>
                            <option value="">Insert a ready-made text ...</option>
                            @foreach (var canned in Model.CannedReplies)
                            {
                                <option value="@canned.Id" data-body="@HtmlSanitizer.Sanitize(canned.Body)">@canned.Title</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <label for="replyBody">@(role.IsStaff ? "Reply to the brokerage house" : "Your reply")</label>
                    <textarea class="textarea" name="body" id="replyBody" data-rte rows="4" aria-label="Reply" placeholder="Write your reply"></textarea>
                </div>
                <partial name="_Attachments" />
                <div class="reply-actions">
                    <button type="submit" class="btn btn-primary" data-reply-send><icon name="send" /> <span>Send reply</span></button>
                    @if (role.IsStaff)
                    {
                        <label class="check"><input type="checkbox" name="internalNote" value="true" data-note-toggle> <span>Internal note: only XFL staff can read it</span></label>
                    }
                </div>
            </form>
        </section>

        <section class="card">
            <div class="card-head"><h2>Attachments</h2><span class="sub">@attachments.Count @(attachments.Count == 1 ? "file" : "files")</span></div>
            <div class="card-body">
                @if (attachments.Count == 0)
                {
                    <p class="muted">No files are attached.</p>
                }
                else
                {
                    <ul class="files" style="margin-top: 0">
                        @foreach (var file in attachments)
                        {
                            <li class="file">
                                <icon name="@Ui.FileIcon(file.FileName)" />
                                <span class="file-name">@file.FileName</span>
                                <a class="btn btn-sm right" asp-action="DownloadAttachment" asp-route-att="@file.AttachmentId"><icon name="download" /> Download</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>

    <aside class="stack">
        @if (choices.Count > 0)
        {
            <section class="card" id="status">
                <div class="card-head"><h2>Status</h2><span class="sub">@Ui.StatusPill(Model.IStatus)</span></div>
                <div class="card-body status-box">
                    <p class="muted">@(closed ? "Reopen the ticket as:" : "Move the ticket to:")</p>
                    <div class="status-moves">
                        @foreach (var choice in choices)
                        {
                            <form asp-action="SetTicketStatus" asp-route-id="@Model.IssueId" method="post"
                                  data-confirm-submit="@(choice.Key == TicketStatus.Closed ? "Close ticket " + Model.TicketNumber + "?" : null)"
                                  data-action="@(choice.Key == TicketStatus.Closed ? "Close ticket" : null)"
                                  data-confirm-text="@(choice.Key == TicketStatus.Closed ? "The people of the brokerage house can no longer change it. It can be reopened." : null)">
                                <input type="hidden" name="status" value="@choice.Key">
                                <button type="submit" class="btn btn-sm @(choice.Key == forward ? "btn-primary" : "")" title="@choice.About"><icon name="@choice.Icon" /> @choice.Name</button>
                            </form>
                        }
                    </div>
                </div>
            </section>
        }
        else if (role.IsStaff && !assigned && !closed && Model.CanWork)
        {
            <section class="card" id="status">
                <div class="card-head"><h2>Status</h2><span class="sub">@Ui.StatusPill(Model.IStatus)</span></div>
                <div class="card-body"><p class="muted" style="margin: 0">The status can be set once the ticket has an engineer.</p></div>
            </section>
        }

        @if (Model.CanRate)
        {
            <section class="card" id="rating">
                <div class="card-head"><h2>How was the support?</h2></div>
                <form class="card-body rate-box" asp-action="RateTicket" asp-route-id="@Model.IssueId" method="post">
                    <fieldset class="rate">
                        <legend class="sr-only">Your rating, from 1 (bad) to 5 (very good)</legend>
                        @for (var value = 1; value <= 5; value++)
                        {
                            <label><input type="radio" name="rating" value="@value" required><span>@value</span></label>
                        }
                    </fieldset>
                    <div class="rate-ends"><span>Bad</span><span>Very good</span></div>
                    <div class="field">
                        <label for="ratingComment">Anything to add? <span class="muted">(optional)</span></label>
                        <textarea class="textarea" name="comment" id="ratingComment" rows="2" maxlength="1000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send rating</button>
                </form>
            </section>
        }
        else if (Model.Rating != null)
        {
            <section class="card" id="rating">
                <div class="card-head"><h2>Rating</h2><span class="sub">@Ui.Date(Model.RatedAt)</span></div>
                <div class="card-body">
                    <div class="rated r-@Model.Rating" title="@Model.Rating of 5">
                        <b>@Model.Rating</b><span>of 5</span>
                        <span class="rate-dots" aria-hidden="true">@for (var value = 1; value <= 5; value++) { <i class="@(value <= Model.Rating ? "on" : "")"></i> }</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.RatingComment))
                    {
                        <p style="margin: 10px 0 0; white-space: pre-line">&ldquo;@Model.RatingComment&rdquo;</p>
                    }
                    <p class="muted" style="margin: 8px 0 0">Given by @Model.CreatedBy.</p>
                </div>
            </section>
        }

        <section class="card" id="service">
            <div class="card-head"><h2>Service times</h2></div>
            <div class="card-body">
                <dl class="facts">
                    <dt>First response</dt>
                    <dd>
                        @Ui.SlaPill(Model.ResponseClock, Model.FirstResponseAt == null ? "not yet" : null)
                        @if (Model.ResponseClock.Due != null)
                        {
                            <span class="t-meta">Target @Ui.Stamp(Model.ResponseClock.Due)@(Model.FirstResponseAt != null ? ", answered " + Ui.Stamp(Model.FirstResponseAt) : "")</span>
                        }
                        else if (Model.FirstResponseAt != null)
                        {
                            <span class="t-meta">@Ui.Stamp(Model.FirstResponseAt)</span>
                        }
                    </dd>
                    <dt>Solution</dt>
                    <dd>
                        @Ui.SlaPill(Model.ResolveClock, Model.ResolvedAt == null ? "not yet" : null)
                        @if (Model.ResolveClock.Due != null)
                        {
                            <span class="t-meta">Target @Ui.Stamp(Model.ResolveClock.Due)@(Model.ResolvedAt != null ? ", solved " + Ui.Stamp(Model.ResolvedAt) : "")</span>
                        }
                        else if (Model.ResolvedAt != null)
                        {
                            <span class="t-meta">@Ui.Stamp(Model.ResolvedAt)</span>
                        }
                    </dd>
                    @if (Model.ReopenCount > 0)
                    {
                        <dt>Reopened</dt>
                        <dd>@Model.ReopenCount @(Model.ReopenCount == 1 ? "time" : "times")</dd>
                    }
                </dl>
                @if (!hasTargets)
                {
                    <p class="muted" style="margin: 12px 0 0">This ticket has no targets: it was raised before service targets applied, or its priority has none.</p>
                }
            </div>
        </section>

        <section class="card" id="assignment">
            <div class="card-head"><h2>Handling</h2></div>
            @if (canAssign)
            {
                <form class="card-body assign-box" asp-action="AssignTicket" asp-route-id="@Model.IssueId" method="post">
                    <div class="field">
                        <label for="engineerId">Support engineer</label>
                        <select class="select" name="engineerId" id="engineerId" required="@(!assigned)">
                            <option value="">@(assigned ? "Unassigned" : "Choose an engineer")</option>
                            @foreach (var engineer in engineers)
                            {
                                <option value="@engineer.Id" selected="@(engineer.Id == currentEngineer)">@engineer.Name (@engineer.Open open)</option>
                            }
                        </select>
                        @if (engineers.Count == 0)
                        {
                            <span class="hint">There is no active support engineer yet. A platform admin creates them under Users.</span>
                        }
                        else if (assigned && currentEngineer == null)
                        {
                            <span class="hint">@Model.AssgnBy is no longer an active support engineer. Choose somebody else.</span>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary"><icon name="user-check" /> @(assigned ? "Reassign" : "Assign")</button>
                </form>
            }
            else if (canTake && !assigned)
            {
                <form class="card-body assign-box" asp-action="TakeTicket" asp-route-id="@Model.IssueId" method="post">
                    <p class="muted" style="margin: 0">Nobody works on this ticket yet.</p>
                    <button type="submit" class="btn btn-primary"><icon name="user-check" /> Take this ticket</button>
                </form>
            }
            else if (canTake && Model.IsMine)
            {
                <form class="card-body assign-box" asp-action="ReleaseTicket" asp-route-id="@Model.IssueId" method="post"
                      data-confirm-submit="Give ticket @Model.TicketNumber back?" data-action="Give back"
                      data-confirm-text="It becomes unassigned again, so another engineer or a manager can pick it up.">
                    <p class="muted" style="margin: 0">This ticket is yours.</p>
                    <button type="submit" class="btn"><icon name="undo-2" /> Give back</button>
                </form>
            }
            else if (canTake)
            {
                <div class="card-body assign-box">
                    <p class="muted" style="margin: 0">@Model.AssgnBy works on this ticket. Somebody who assigns tickets can give it to another engineer.</p>
                </div>
            }
            <div class="card-body">
                <dl class="facts">
                    <dt>Assigned to</dt>
                    <dd class="@(assigned ? "" : "none")">@(assigned ? Model.AssgnBy : "Nobody yet")</dd>
                    <dt>Assigned on</dt>
                    <dd class="@(Model.AssgnOn.HasValue ? "" : "none")">@(Model.AssgnOn.HasValue ? Ui.Stamp(Model.AssgnOn) : "-")</dd>
                    <dt>Assigned by</dt>
                    <dd class="@(string.IsNullOrEmpty(Model.ApproveBy) ? "none" : "")">@(string.IsNullOrEmpty(Model.ApproveBy) ? "-" : Model.ApproveBy)</dd>
                    @if (Model.UpdatedOn.HasValue)
                    {
                        <dt>Last edited</dt>
                        <dd>@Ui.Stamp(Model.UpdatedOn)@(string.IsNullOrEmpty(Model.UpdatedBy) ? "" : " by " + Model.UpdatedBy)</dd>
                    }
                    @if (closed)
                    {
                        <dt>Closed</dt>
                        <dd>@Ui.Stamp(Model.CloseOn)@(string.IsNullOrEmpty(Model.ClosedbyName) ? "" : " by " + Model.ClosedbyName)</dd>
                    }
                </dl>
            </div>
        </section>

        <partial name="_TicketFacts" model="Model" />

        <section class="card" id="history">
            <div class="card-head"><h2>History</h2><span class="sub">Who did what</span></div>
            <div class="card-body">
                @if (Model.History.Count == 0)
                {
                    <p class="muted" style="margin: 0">Nothing was recorded for this ticket yet. Changes are recorded from now on.</p>
                }
                else
                {
                    <ol class="timeline">
                        @foreach (var line in Model.History)
                        {
                            <li class="@AuditActions.Tone(line.Action)">
                                <b>@(string.IsNullOrEmpty(line.Details) ? AuditActions.Name(line.Action) : line.Details)</b>
                                <span>@line.UserName.Split(" (")[0]@(string.IsNullOrEmpty(line.Role) ? "" : ", " + line.Role) &middot; @Ui.Stamp(line.At)</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>
    </aside>
</div>
