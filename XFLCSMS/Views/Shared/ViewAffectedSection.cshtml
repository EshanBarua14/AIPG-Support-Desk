@model XFLCSMS.Models.Affected.AffectedSection
@{
    ViewData["Title"] = Model.ASection;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="AffectedSectionList"><icon name="arrow-left" /> Affected sections</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.ASection</h1>
        <p class="page-sub">Affected section</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditAffectedSection" asp-route-id="@Model.AffectedSectionId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.AffectedSectionId</dd>
            <dt>Name</dt>
            <dd>@Model.ASection</dd>
            <dt>Product</dt>
            <dd><partial name="_ProductName" model="Model.Product" /></dd>
        </dl>
    </div>
</section>
