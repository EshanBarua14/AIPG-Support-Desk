@model XFLCSMS.Models.Brocarage.Brokerage
@{
    ViewData["Title"] = Model.BrokerageHouseName;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="BrocarageHouseList"><icon name="arrow-left" /> Brokerage houses</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.BrokerageHouseName</h1>
        <p class="page-sub">Brokerage house</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditBrocarage" asp-route-id="@Model.BrokerageId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.BrokerageId</dd>
            <dt>Name</dt>
            <dd>@Model.BrokerageHouseName</dd>
            <dt>Acronym</dt>
            <dd>@Model.BrokerageHouseAcronym</dd>
        </dl>
    </div>
</section>
