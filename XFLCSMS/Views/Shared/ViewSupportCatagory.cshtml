@model XFLCSMS.Models.Support.SupportCatagory
@{
    ViewData["Title"] = Model.SCatagory;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportCatagoryList"><icon name="arrow-left" /> Support categories</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.SCatagory</h1>
        <p class="page-sub">Support category</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditSupportCatagory" asp-route-id="@Model.SupportCatagoryId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.SupportCatagoryId</dd>
            <dt>Name</dt>
            <dd>@Model.SCatagory</dd>
            <dt>Product</dt>
            <dd><partial name="_ProductName" model="Model.Product" /></dd>
        </dl>
    </div>
</section>
