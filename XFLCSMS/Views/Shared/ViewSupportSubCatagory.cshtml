@model XFLCSMS.Models.Support.SupportSubCatagory
@{
    ViewData["Title"] = Model.SubCatagory;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportSubCatagoryList"><icon name="arrow-left" /> Support sub-categories</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.SubCatagory</h1>
        <p class="page-sub">Support sub-category</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditSupportSubCatagory" asp-route-id="@Model.SupportSubCatagoryId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.SupportSubCatagoryId</dd>
            <dt>Name</dt>
            <dd>@Model.SubCatagory</dd>
            <dt>Product</dt>
            <dd><partial name="_ProductName" model="Model.Product" /></dd>
        </dl>
    </div>
</section>
