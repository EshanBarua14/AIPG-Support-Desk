@model XFLCSMS.Models.Support.SupportType
@{
    ViewData["Title"] = Model.SType;
    ViewData["PageClass"] = "narrow";
}
<a class="back" asp-action="SupportTypeList"><icon name="arrow-left" /> Support types</a>

<header class="page-head">
    <div>
        <h1 class="page-title">@Model.SType</h1>
        <p class="page-sub">Support type</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="EditSupportType" asp-route-id="@Model.SupportTypeId"><icon name="pencil" /> Edit</a>
    </div>
</header>

<section class="card">
    <div class="card-body">
        <dl class="facts">
            <dt>ID</dt>
            <dd>@Model.SupportTypeId</dd>
            <dt>Name</dt>
            <dd>@Model.SType</dd>
            <dt>Product</dt>
            <dd><partial name="_ProductName" model="Model.Product" /></dd>
        </dl>
    </div>
</section>
