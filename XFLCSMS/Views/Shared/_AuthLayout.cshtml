@*
    Frame of the pages before sign-in: on the left the brand panel with an example ticket travelling through the
    statuses (animated in wwwroot/css/app.css, section 9; still with "reduce motion"), the form on the right.
*@
@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(title) ? Ui.Brand : title + " - " + Ui.Brand)</title>
    <meta name="app-base" content="@Url.Content("~/")">
    <meta name="icon-sprite" content="@Url.Content("~/img/icons.svg")?v=@IconTagHelper.SpriteVersion">
    <partial name="_Theme" />
    <link rel="icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>
<body>
    <div class="auth">
        <aside class="auth-brand">
            <div class="globe" aria-hidden="true"></div>
            <a class="mark" asp-controller="RegisterLogin" asp-action="Login">
                <span class="brand-mark"><img src="~/img/xpert-logo.png" asp-append-version="true" alt="" width="46" height="46"></span>
                <span class="brand-text"><b>@Ui.Brand</b><span>Customer Support Management System</span></span>
            </a>

            @* an example ticket on its way through the statuses (decoration: the data is made up) *@
            <div class="journey" aria-hidden="true">
                <div class="journey-card">
                    <div class="journey-head">
                        <span class="journey-num"><b>BCL</b><span>0000042</span></span>
                        <span class="journey-state">
                            <span class="s1">Unassigned</span><span class="s2">Assigned</span><span class="s3">In progress</span><span class="s4">Waiting for review</span><span class="s5">Deployed</span>
                        </span>
                    </div>
                    <div class="journey-title">Buy orders rejected since market open</div>
                    <div class="journey-by">Xpert Trading OMS, high priority</div>
                    <div class="journey-track"><span class="fill"></span><i></i><i></i><i></i><i></i><i></i></div>
                    <div class="journey-stops"><span>Raised</span><span>Assigned</span><span>In progress</span><span>Review</span><span>Deployed</span></div>
                    <ul class="journey-log">
                        <li><time>09:41</time><span>Raised by the dealing desk</span></li>
                        <li><time>09:43</time><span>Assigned to a support engineer</span></li>
                        <li><time>09:58</time><span>Cause found: a limit rule after last night's update</span></li>
                        <li><time>10:20</time><span>Fix waiting for review</span></li>
                        <li><time>10:32</time><span>Deployed. Orders go through again</span></li>
                    </ul>
                </div>
                <div class="journey-note"><icon name="bell-ring" /><span>Your ticket BCL 0000042 is deployed</span></div>
            </div>

            <div class="auth-copy">
                <h1>Support for the brokerage houses running on Xpert.</h1>
                <p>Raise a ticket, follow who is working on it, and know the moment the fix is live.</p>
                <div class="xfl">Xpert Fintech Limited</div>
            </div>
        </aside>

        <main class="auth-main">
            <div class="auth-card @ViewData["CardClass"]">
                <a class="auth-mark-s" asp-controller="RegisterLogin" asp-action="Login">
                    <span class="brand-mark"><img src="~/img/xpert-logo.png" asp-append-version="true" alt="" width="40" height="40"></span><b>@Ui.Brand</b>
                </a>
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
