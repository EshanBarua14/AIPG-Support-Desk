@*
    The one page frame of the signed-in area: side menu, top bar, page, footer.
    All four roles use it; what differs per role is decided in Ui.Role (Infrastructure/Ui.cs).
*@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var role = Ui.Role(ViewContext);
    var me = ViewBag.Profile as XFLCSMS.Models.Register.User;
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(title) ? "XFL CSMS" : title + " - XFL CSMS")</title>
    <meta name="app-base" content="@Url.Content("~/")">
    <meta name="icon-sprite" content="@Url.Content("~/img/icons.svg")?v=@IconTagHelper.SpriteVersion">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
    <partial name="_Theme" />
    <link rel="icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>
<body>
    <div class="app" id="app">
        <script>if (function () { try { return localStorage.getItem('csms-nav') === 'hidden'; } catch (e) { return false; } }()) { document.getElementById('app').classList.add('nav-hidden'); }</script>

        <aside class="nav" id="nav" aria-label="Main menu">
            <partial name="_Nav" />
        </aside>
        <div class="backdrop"></div>

        <div class="sheet">
            <header class="topbar">
                <button type="button" class="btn btn-icon" data-nav-toggle aria-label="Show or hide the menu" aria-controls="nav">
                    <icon name="panel-left" />
                </button>

                <form class="topbar-search hide-s" asp-controller="@role.Controller" asp-action="@role.TicketList" method="get" role="search">
                    <icon name="search" />
                    <input class="input input-sm" type="search" name="searchString" placeholder="Find a ticket by number, title or assignee" aria-label="Find a ticket">
                </form>

                <span class="spacer"></span>

                @if (role.CanCreateTicket)
                {
                    <a class="btn btn-primary btn-sm" asp-controller="@role.Controller" asp-action="IssueRaiseFrom">
                        <icon name="plus" /> <span class="hide-s">Create ticket</span><span class="show-s">New</span>
                    </a>
                }

                <button type="button" class="btn btn-icon" data-theme-toggle aria-label="Switch between light and dark" title="Light / dark">
                    <icon name="moon" class="theme-moon" /><icon name="sun" class="theme-sun" />
                </button>

                <div class="menu">
                    <button type="button" class="user-btn" data-menu aria-haspopup="true" aria-expanded="false">
                        <span class="avatar" aria-hidden="true">@Ui.Initials(me?.FullName)</span>
                        <span class="hide-s">@(me?.FullName)</span>
                        <icon name="chevron-down" />
                    </button>
                    <div class="menu-panel" hidden>
                        <div class="menu-head">
                            <b>@(me?.FullName)</b>
                            <span>@role.Label</span>
                        </div>
                        <a asp-controller="@role.Controller" asp-action="Profile"><icon name="user" /> My profile</a>
                        <a asp-controller="@role.Controller" asp-action="ChangePassword"><icon name="key-round" /> Change password</a>
                        <form asp-controller="@role.Controller" asp-action="Logout" method="post">
                            <button type="submit"><icon name="log-out" /> Sign out</button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="page @ViewData["PageClass"]" id="main">
                @* one-off messages set by the controllers (ticket created, file refused, ...) *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert"><icon name="circle-alert" /><span>@TempData["ErrorMessage"]</span></div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="status"><icon name="check" /><span>@TempData["SuccessMessage"]</span></div>
                }
                @RenderBody()
            </main>

            <footer class="foot">
                <span>&copy; @DateTime.Now.Year <a href="https://xpertfintech.com" target="_blank" rel="noopener">Xpert Fintech Limited</a></span>
                <span class="spacer"></span>
                <span>XFL CSMS @Ui.Version</span>
            </footer>
        </div>
    </div>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
