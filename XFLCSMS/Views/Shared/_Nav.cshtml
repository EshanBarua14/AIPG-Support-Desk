@*
    Side menu. One list for the five roles; an entry is there when the role holds the permission for it
    (Infrastructure/Rbac.cs), so the menu and what the server allows cannot drift apart.

    (Razor never leaves a data-* attribute out, so "data-nav-active" always carries true or false.)

    Every group can be folded with a click on its name, and so can the sub menu "By status". What is folded is
    remembered per browser (wwwroot/js/app.js, "csms-nav-closed"); the group of the page that is open never folds away.
*@
@functions {
    private class Entry
    {
        public string Text = string.Empty;
        public string Action = string.Empty;
        public string Icon = string.Empty;
        /// <summary>Status filter of the main ticket list this entry opens.</summary>
        public string? Status;
        public int Count;
        public bool Hot;
        public string? CountTitle;
        /// <summary>Entries of a sub menu.</summary>
        public List<Entry>? Children;
    }

    private class Group
    {
        public string Key = string.Empty;
        public string Label = string.Empty;
        public List<Entry> Items = new();
    }

    private static Entry Item(string text, string action, string icon, int count = 0, bool hot = false, string? countTitle = null, string? status = null)
    {
        return new Entry { Text = text, Action = action, Icon = icon, Count = count, Hot = hot, CountTitle = countTitle, Status = status };
    }
}
@{
    var role = Ui.Role(ViewContext);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentStatus = TicketStatus.Normalize(Context.Request.Query["status"]);
    int mine = ViewBag.AssignedToMeCount ?? 0;
    int pendingUsers = ViewBag.PendingUsersCount ?? 0;
    var statusCounts = ViewBag.NavStatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();

    var groups = new List<Group>();

    // ---- tickets
    var tickets = new Group { Key = "tickets", Label = "Tickets" };
    if (role.CanCreateTicket) { tickets.Items.Add(Item("Create ticket", "IssueRaiseFrom", "ticket-plus")); }
    tickets.Items.Add(Item(role.TicketListName, role.TicketList, "ticket"));
    if (role.IsEngineer) { tickets.Items.Add(Item("Assigned to me", "AssignedTicketList", "user-check", mine, false, mine == 1 ? "1 open ticket is assigned to you" : mine + " open tickets are assigned to you")); }
    tickets.Items.Add(Item("Board", "TicketBoard", "square-kanban"));

    var byStatus = new Entry { Text = "By status", Icon = "tags", Children = new List<Entry>() };
    foreach (var status in TicketStatus.All)
    {
        var count = statusCounts.TryGetValue(status.Key, out var number) ? number : 0;
        if (status.Key == TicketStatus.Unassigned)
        {
            byStatus.Children.Add(Item(status.Name, "UnassignedTicketList", status.Icon, count, role.IsStaff, count == 1 ? "1 ticket waits for an engineer" : count + " tickets wait for an engineer"));
        }
        else if (status.Key == TicketStatus.Closed)
        {
            byStatus.Children.Add(Item(status.Name, "ClosedTicketList", status.Icon));
        }
        else
        {
            byStatus.Children.Add(Item(status.Name, role.TicketList, status.Icon, count, false, (count == 1 ? "1 ticket: " : count + " tickets: ") + status.Name.ToLowerInvariant(), status.Key));
        }
    }
    tickets.Items.Add(byStatus);

    if (role.Can(Permission.Workload)) { tickets.Items.Add(Item("Workload", "Workload", "signal-high")); }
    tickets.Items.Add(Item("Ticket report", "Reports", "chart-column"));
    if (role.Can(Permission.AuditTickets) && !role.Can(Permission.AuditAll)) { tickets.Items.Add(Item("Ticket activity", "AuditTrail", "clipboard-check")); }
    groups.Add(tickets);

    // ---- the own brokerage house
    if (role.Can(Permission.UsersHouse) || role.Can(Permission.BranchesHouse) || role.Can(Permission.AuditHouse))
    {
        var house = new Group { Key = "house", Label = "Organization" };
        if (role.Can(Permission.UsersHouse)) { house.Items.Add(Item("Users", "UserList", "user-cog", pendingUsers, true, pendingUsers + " registered, waiting for activation")); }
        if (role.Can(Permission.BranchesHouse)) { house.Items.Add(Item("Branches", "Organization", "building-2")); }
        if (role.Can(Permission.AuditHouse)) { house.Items.Add(Item("Activity", "AuditTrail", "clipboard-check")); }
        groups.Add(house);
    }

    // ---- everybody's accounts and the master data
    if (role.Can(Permission.UsersAll) || role.Can(Permission.MasterData))
    {
        var admin = new Group { Key = "admin", Label = "Administration" };
        if (role.Can(Permission.UsersAll)) { admin.Items.Add(Item("Users", "UserList", "user-cog", pendingUsers, true, pendingUsers + " registered, waiting for activation")); }
        if (role.Can(Permission.MasterData))
        {
            admin.Items.Add(Item("Brokerage houses", "BrocarageHouseList", "building-2"));
            admin.Items.Add(Item("Branches", "BranchList", "map-pin"));
            admin.Items.Add(new Entry
            {
                Text = "Support lists", Icon = "layers", Children = new List<Entry>
                {
                    Item("Support types", "SupportTypeList", "headset"),
                    Item("Support categories", "SupportCatagoryList", "folder"),
                    Item("Support sub-categories", "SupportSubCatagoryList", "folder-tree"),
                    Item("Affected sections", "AffectedSectionList", "puzzle")
                }
            });
        }
        groups.Add(admin);
    }

    // ---- the system itself
    if (role.Can(Permission.AuditAll) || role.Can(Permission.SystemHealth) || role.Can(Permission.PermissionsEdit) || role.Can(Permission.SystemSettings))
    {
        var system = new Group { Key = "system", Label = "System" };
        if (role.Can(Permission.AuditAll)) { system.Items.Add(Item("Audit trail", "AuditTrail", "shield-check")); }
        if (role.Can(Permission.SystemHealth)) { system.Items.Add(Item("System health", "SystemHealth", "circle-dot")); }
        if (role.Can(Permission.PermissionsEdit)) { system.Items.Add(Item("Roles & permissions", "Permissions", "sliders-horizontal")); }
        if (role.Can(Permission.SystemSettings))
        {
            system.Items.Add(Item("Notification settings", "NotificationSettings", "bell-ring"));
            system.Items.Add(Item("Demo data", "DemoData", "flask-conical"));
        }
        groups.Add(system);
    }

    // ---- the personal to-do list of every role comes last
    var todo = new Group { Key = "todo", Label = "To-do" };
    todo.Items.Add(Item("In progress", "ViewTodo", "list-todo"));
    todo.Items.Add(Item("All to-dos", "AllTodo", "list"));
    todo.Items.Add(Item("Completed", "CompletedTodo", "list-checks"));
    todo.Items.Add(Item("To-do report", "TodoReports", "file-text"));
    if (role.Can(Permission.TeamTodos))
    {
        todo.Items.Add(Item("Team to-dos", "ViewAllTodo", "users"));
        todo.Items.Add(Item("Team to-do report", "AllTodoReports", "clipboard-check"));
    }
    groups.Add(todo);

    // pages that have no menu entry of their own light up the entry they belong to
    var parents = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["TicketView"] = role.TicketList, ["EditTicket"] = role.TicketList, ["Pagination"] = role.TicketList,
        ["GetTodo"] = "ViewTodo",
        ["UserView"] = "UserList", ["EditUser"] = "UserList", ["CreateUser"] = "UserList",
        ["CreateBrocarage"] = "BrocarageHouseList", ["EditBrocarage"] = "BrocarageHouseList", ["ViewBrocarageHouse"] = "BrocarageHouseList",
        ["CreateBranch"] = "BranchList", ["EditBranch"] = "BranchList", ["ViewBranch"] = "BranchList",
        ["CreateSupportType"] = "SupportTypeList", ["EditSupportType"] = "SupportTypeList", ["ViewSupportType"] = "SupportTypeList",
        ["CreateSupportCatagory"] = "SupportCatagoryList", ["EditSupportCatagory"] = "SupportCatagoryList", ["ViewSupportCatagory"] = "SupportCatagoryList",
        ["CreateSupportSubCatagory"] = "SupportSubCatagoryList", ["EditSupportSubCatagory"] = "SupportSubCatagoryList", ["ViewSupportSubCatagory"] = "SupportSubCatagoryList",
        ["CreateAffectedSection"] = "AffectedSectionList", ["EditAffectedSection"] = "AffectedSectionList", ["ViewAffectedSection"] = "AffectedSectionList"
    };
    var activeAction = parents.TryGetValue(currentAction, out var parent) ? parent : currentAction;

    // the main list with a status chosen belongs to the status entry, not to "All tickets"
    Func<Entry, bool> isActive = entry => entry.Action.Length > 0
        && string.Equals(entry.Action, activeAction, StringComparison.OrdinalIgnoreCase)
        && (!string.Equals(entry.Action, role.TicketList, StringComparison.OrdinalIgnoreCase)
            || entry.Status == (string.Equals(currentAction, activeAction, StringComparison.OrdinalIgnoreCase) ? currentStatus : null));
    Func<Entry, bool> holdsActive = entry => entry.Children != null ? entry.Children.Any(isActive) : isActive(entry);
}
@functions {
    // a method with markup that uses tag helpers has to be async
    private async Task Link(Ui.RoleInfo role, Entry item, bool active)
    {
        <a asp-controller="@role.Controller" asp-action="@item.Action" asp-route-status="@item.Status" class="nav-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)">
            <icon name="@item.Icon" />
            <span>@item.Text</span>
            @if (item.Count > 0)
            {
                <span class="nav-count @(item.Hot ? "hot" : "")" title="@item.CountTitle">@item.Count</span>
            }
        </a>
    }
}
<a class="nav-brand" asp-controller="@role.Controller" asp-action="Dashbord">
    <img src="~/img/xpert-logo.png" asp-append-version="true" alt="" width="36" height="36">
    <span><b>Xpert CSMS</b><span>@role.Label</span></span>
</a>

<div class="nav-group">
    @{ await Link(role, Item("Dashboard", "Dashbord", "layout-dashboard"), string.Equals(activeAction, "Dashbord", StringComparison.OrdinalIgnoreCase)); }
</div>

@foreach (var group in groups)
{
    var groupActive = group.Items.Any(holdsActive);
    <details class="nav-group" data-nav-fold="@group.Key" data-nav-active="@(groupActive ? "true" : "false")" open>
        <summary class="nav-label"><span>@group.Label</span><icon name="chevron-down" /></summary>
        @foreach (var item in group.Items)
        {
            if (item.Children == null)
            {
                await Link(role, item, isActive(item));
            }
            else
            {
                var subActive = item.Children.Any(isActive);
                var total = item.Children.Where(child => child.Hot).Sum(child => child.Count);
                <details class="nav-sub" data-nav-fold="@(group.Key + "-" + item.Text.Replace(" ", "").ToLowerInvariant())" data-nav-active="@(subActive ? "true" : "false")" open>
                    <summary class="nav-link">
                        <icon name="@item.Icon" />
                        <span>@item.Text</span>
                        @if (total > 0)
                        {
                            <span class="nav-count hot when-closed">@total</span>
                        }
                        <icon name="chevron-down" class="fold" />
                    </summary>
                    @foreach (var child in item.Children)
                    {
                        await Link(role, child, isActive(child));
                    }
                </details>
            }
        }
    </details>
}
@* fold what this browser had folded, before the menu is painted *@
<script>
    (function () {
        var closed;
        try { closed = JSON.parse(localStorage.getItem('csms-nav-closed') || '[]'); } catch (e) { closed = []; }
        if (!Array.isArray(closed)) { closed = []; }
        document.querySelectorAll('#nav details[data-nav-fold]').forEach(function (group) {
            if (closed.indexOf(group.getAttribute('data-nav-fold')) >= 0 && group.getAttribute('data-nav-active') !== 'true') { group.removeAttribute('open'); }
        });
    }());
</script>
