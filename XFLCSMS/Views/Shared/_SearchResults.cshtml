@* Result of the ticket report (loaded into the report page, and what gets printed). *@
@model XFLCSMS.Models.Admin.ReportView
@{
    var info = Model.HeaderInfo ?? new XFLCSMS.Models.Admin.HeaderInfo();
    var issues = Model.Issues?.OrderByDescending(issue => issue.IssueId).ToList() ?? new List<XFLCSMS.Models.Issue.IssueTable>();
    var total = info.TotalTicket ?? issues.Count;
    var closed = info.TotalCloseTicket ?? 0;
    var products = Model.Products.ToDictionary(product => product.ProductId);
    var showProduct = products.Count > 0;
}
<section class="card flush">
    <div class="card-head">
        <div>
            <h2>@info.ReportName ticket report</h2>
            <span class="sub">Created @Ui.Stamp(DateTime.Now)</span>
        </div>
    </div>
    <div class="card-body">
        <div class="queue-side" style="margin: 0">
            <div class="kpi"><span class="fig num" id="totalTicketPlaceholder">@total</span><span>tickets</span></div>
            <div class="kpi"><span class="fig num" id="totalOpenReportsPlaceholder">@(total - closed)</span><span>open</span></div>
            <div class="kpi"><span class="fig num" id="totalClosedReportsPlaceholder">@closed</span><span>closed</span></div>
        </div>
        <div class="legend status-legend" id="reportByStatus" style="margin-top: 14px">
            @foreach (var status in TicketStatus.All)
            {
                <span><i class="q-@status.Css"></i>@status.Name <b>@info.ByStatus.GetValueOrDefault(status.Key)</b></span>
            }
        </div>
        <dl class="facts" style="margin-top: 16px; max-width: 520px">
            <dt>Brokerage house</dt>
            <dd id="brokerageHouseNamePlaceholder">@(string.IsNullOrEmpty(info.BrokerageHouseName) ? "All" : info.BrokerageHouseName)</dd>
            <dt>Employee</dt>
            <dd id="employeeNamePlaceholder">@(string.IsNullOrEmpty(info.EmployeeName) ? "All" : info.EmployeeName)</dd>
            @if (!string.IsNullOrEmpty(info.StatusName))
            {
                <dt>Status</dt>
                <dd>@info.StatusName</dd>
            }
            @if (!string.IsNullOrEmpty(info.ProductName))
            {
                <dt>Product</dt>
                <dd>@info.ProductName</dd>
            }
        </dl>

        @if (Model.Charts != null)
        {
            var charts = Model.Charts;
            var showProducts = charts.Products.Count > 1;
            var showHouses = charts.Houses.Count > 1;
            @* drawn by wwwroot/js/charts.js; every chart also has its numbers as a table (button "Table") *@
            <div class="report-charts-wrap no-print" data-charts>
                <script type="application/json" data-chart-data>@Html.Raw(TicketStats.ToJson(charts))</script>
                <div class="row" style="margin: 22px 0 12px">
                    <h3 style="font: 600 15px/1.3 var(--font)">In charts</h3>
                    <span class="muted small">@charts.PeriodName</span>
                    <button type="button" class="btn btn-sm right" data-chart-view aria-pressed="false" title="Show the numbers as tables"><icon name="file-spreadsheet" /> <span>Table</span></button>
                </div>
                <div class="report-charts">
                    <div class="wide">
                        <h3>Raised and closed per @charts.Bucket</h3>
                        <div class="chart" data-chart="trend" data-key="trend"></div>
                    </div>
                    <div>
                        <h3>By priority</h3>
                        <div class="chart" data-chart="split" data-key="priorities" data-name="Priority"></div>
                    </div>
                    @if (showProducts)
                    {
                        <div>
                            <h3>By product</h3>
                            <div class="chart" data-chart="split" data-key="products" data-name="Product"></div>
                        </div>
                    }
                    @if (showHouses)
                    {
                        <div>
                            <h3>By brokerage house</h3>
                            <div class="chart" data-chart="split" data-key="houses" data-name="Brokerage house"></div>
                        </div>
                    }
                    <div>
                        <h3>Time to close</h3>
                        <div class="chart" data-chart="columns" data-key="closeTimes" data-name="From raised to closed" data-empty="None of these tickets is closed."></div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (issues.Count == 0)
    {
        <div class="empty" style="border-top: 1px solid var(--line)"><icon name="inbox" /><b>No tickets match these filters</b><span>Widen the dates or clear a filter and run the report again.</span></div>
    }
    else
    {
        <div class="table-wrap" style="border-top: 1px solid var(--line)">
            <table class="table tickets" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col">Ticket</th>
                        <th scope="col">Title</th>
                        @if (showProduct)
                        {
                            <th scope="col">Product</th>
                        }
                        <th scope="col">Raised</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col">Closed by</th>
                        <th scope="col">Priority</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in issues)
                    {
                        <tr>
                            <td class="tick p-@Ui.PriorityKey(item.Priority)" data-export="@item.TNumber">@Ui.Sym(item.TNumber)</td>
                            <td class="c-title" data-export="@item.ITitle">
                                <span class="t-title">@(string.IsNullOrWhiteSpace(item.ITitle) ? "(no title)" : item.ITitle)</span>
                                @if (item.UpdatedOn.HasValue)
                                {
                                    <span class="t-meta">Edited @Ui.Stamp(item.UpdatedOn)@(string.IsNullOrEmpty(item.UpdatedBy) ? "" : " by " + item.UpdatedBy)</span>
                                }
                            </td>
                            @if (showProduct)
                            {
                                var product = item.ProductId != null && products.TryGetValue(item.ProductId.Value, out var found) ? found : null;
                                <td class="nowrap" data-export="@(product?.Name)" title="@(product?.Name)">@(product?.ShortName)</td>
                            }
                            <td class="nowrap num">@Ui.Date(item.TDate)</td>
                            <td class="c-who">@(string.IsNullOrEmpty(item.AssignBy) ? "Unassigned" : item.AssignBy)</td>
                            <td>@item.ClosedBy</td>
                            <td>@Ui.PriorityPill(item.Priority)</td>
                            <td>@Ui.StatusPill(item.IStatus)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
