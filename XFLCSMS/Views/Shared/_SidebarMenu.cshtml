@*
    Sidebar menu used by the four layouts and the four dashboards. It used to be copied into each of them and
    the copies had drifted apart (missing Reports links, sub-menus that did not open, different wording).
    The entries depend on the role, i.e. on the current controller.
*@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var role = currentController == "Maker" || currentController == "SupportEngineer" || currentController == "SupportManegar"
        ? currentController
        : "Admin";

    // (text, action, icon) - an empty action is a section heading
    var menu = new List<(string Text, string Action, string Icon)>
    {
        ("Dashboard", "Dashbord", "fas fa-tachometer-alt"),
        ("TICKETS", "", "")
    };

    if (role == "Admin")
    {
        menu.Add(("All Tickets", "AdminView", "fas fa-ticket-alt"));
    }
    else
    {
        menu.Add(("Create Ticket", "IssueRaiseFrom", "fas fa-plus-circle"));
        menu.Add((role == "Maker" ? "My Tickets" : "All Tickets", role == "Maker" ? "MackerTicketList" : "AllTicketList", "fas fa-ticket-alt"));
    }

    if (role == "SupportEngineer")
    {
        menu.Add(("Assigned to Me", "AssignedTicketList", "fas fa-user-check"));
    }

    menu.Add(("Unassigned Tickets", "UnassignedTicketList", "fas fa-inbox"));
    menu.Add(("Closed Tickets", "ClosedTicketList", "fas fa-check-circle"));
    menu.Add(("Ticket Report", "Reports", "fas fa-chart-bar"));

    menu.Add(("TO-DO", "", ""));
    menu.Add(("To-Do List", "ViewTodo", "fas fa-tasks"));
    menu.Add(("All To-Dos", "AllTodo", "fas fa-list"));
    menu.Add(("Completed To-Dos", "CompletedTodo", "fas fa-clipboard-check"));
    menu.Add(("To-Do Report", "TodoReports", "fas fa-file-alt"));

    if (role == "Admin")
    {
        menu.Add(("Team To-Dos", "ViewAllTodo", "fas fa-users"));
        menu.Add(("Team To-Do Report", "AllTodoReports", "fas fa-file-invoice"));

        menu.Add(("ADMINISTRATION", "", ""));
        menu.Add(("Users", "UserList", "fas fa-user-cog"));
        menu.Add(("Brokerage Houses", "BrocarageHouseList", "fas fa-building"));
        menu.Add(("Branches", "BranchList", "fas fa-code-branch"));
        menu.Add(("Support Types", "SupportTypeList", "fas fa-headset"));
        menu.Add(("Support Categories", "SupportCatagoryList", "fas fa-folder"));
        menu.Add(("Support Sub-Categories", "SupportSubCatagoryList", "fas fa-folder-open"));
        menu.Add(("Affected Sections", "AffectedSectionList", "fas fa-puzzle-piece"));
    }
}
<ul class="nav nav-pills nav-sidebar flex-column" role="menu">
    @foreach (var item in menu)
    {
        if (item.Action.Length == 0)
        {
            <li class="nav-header">@item.Text</li>
        }
        else
        {
            var active = currentController == role && string.Equals(item.Action, currentAction, StringComparison.OrdinalIgnoreCase) ? "active" : "";
            <li class="nav-item">
                <a asp-controller="@role" asp-action="@item.Action" class="nav-link @active">
                    <i class="nav-icon @item.Icon"></i>
                    <p>@item.Text</p>
                </a>
            </li>
        }
    }
</ul>
<script>
    // Filter box above the menu. (It was wired to AdminLTE's SidebarSearch widget, which never started on
    // these pages, so typing in it did nothing.)
    (function () {
        var holder = document.getElementById('sidebarMenuFilter');
        var box = holder ? holder.querySelector('input') : null;
        if (!box) { return; }
        box.setAttribute('placeholder', 'Search menu');
        box.addEventListener('input', function () {
            var text = box.value.trim().toLowerCase();
            document.querySelectorAll('.nav-sidebar > .nav-item').forEach(function (item) {
                item.style.display = !text || item.textContent.toLowerCase().indexOf(text) >= 0 ? '' : 'none';
            });
            document.querySelectorAll('.nav-sidebar > .nav-header').forEach(function (header) {
                header.style.display = text ? 'none' : '';
            });
        });
        var button = holder.querySelector('button');
        if (button) { button.setAttribute('type', 'button'); }
    })();
</script>
