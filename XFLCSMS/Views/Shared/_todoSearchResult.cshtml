@* Result of the to-do reports (loaded into the report page, and what gets printed). *@
@model XFLCSMS.Models.Todos.TodoReportView
@{
    var info = Model.TodoHederInfo ?? new XFLCSMS.Models.Todos.TodoHederInfo();
    var todos = Model.Todos?.OrderByDescending(todo => todo.Id).ToList() ?? new List<XFLCSMS.Models.Todos.Todo>();
    var showOwner = todos.Any(todo => todo.User != null);
    var number = 1;
}
<section class="card flush">
    <div class="card-head">
        <div>
            <h2>@info.ReportName to-do report</h2>
            <span class="sub">Created @Ui.Stamp(DateTime.Now)</span>
        </div>
    </div>
    <div class="card-body">
        <div class="queue-side" style="margin: 0">
            <div class="kpi"><span class="fig num" id="totalTicketPlaceholder">@(info.TotalTodo ?? todos.Count)</span><span>to-dos</span></div>
            <div class="kpi"><span class="fig num" id="totalOpenReportsPlaceholder">@(info.TotalInprogress ?? 0)</span><span>in progress</span></div>
            <div class="kpi"><span class="fig num" id="totalClosedReportsPlaceholder">@(info.TotalCompleteTodo ?? 0)</span><span>done</span></div>
            <div class="kpi"><span class="fig num" id="totalInQueueReportsPlaceholder">@(info.TotalCanseled ?? 0)</span><span>canceled</span></div>
        </div>
        <dl class="facts" style="margin-top: 16px; max-width: 520px">
            <dt>Brokerage house</dt>
            <dd id="brokerageHouseNamePlaceholder">@(string.IsNullOrEmpty(info.BrokerageHouseName) ? "All" : info.BrokerageHouseName)</dd>
            <dt>User</dt>
            <dd id="employeeNamePlaceholder">@(string.IsNullOrEmpty(info.EmployeeName) ? "All" : info.EmployeeName)</dd>
        </dl>
    </div>

    @if (todos.Count == 0)
    {
        <div class="empty" style="border-top: 1px solid var(--line)"><icon name="list-checks" /><b>No to-dos match these filters</b><span>Widen the dates or clear a filter and run the report again.</span></div>
    }
    else
    {
        <div class="table-wrap" style="border-top: 1px solid var(--line)">
            <table class="table" id="issuesTable">
                <thead>
                    <tr>
                        <th scope="col" class="t-id">No.</th>
                        <th scope="col">To-do</th>
                        @if (showOwner)
                        {
                            <th scope="col">Owner</th>
                        }
                        <th scope="col">Added</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in todos)
                    {
                        <tr>
                            <td class="t-id">@(number++)</td>
                            <td><span class="t-title" style="max-width: 70ch; white-space: normal">@item.Todoname</span></td>
                            @if (showOwner)
                            {
                                <td>@(item.User?.FullName)</td>
                            }
                            <td class="nowrap num">@Ui.Date(item.CreatedOn)</td>
                            <td>@Ui.TodoPill(item.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
